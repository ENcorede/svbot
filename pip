async def save_welcome(chat_id: int, message_id: int):
    db.execute(
        """
        INSERT OR IGNORE INTO welcome_messages
        (chat_id, message_id)
        VALUES (?, ?)
        """,
        (chat_id, message_id)
    )
    db.commit()


async def delete_all_welcomes(chat_id: int):
    rows = db.execute(
        """
        SELECT message_id
        FROM welcome_messages
        WHERE chat_id = ?
        """,
        (chat_id,)
    ).fetchall()

    for row in rows:
        try:
            await bot.delete_message(
                chat_id=chat_id,
                message_id=row["message_id"]
            )
        except Exception:
            pass

    db.execute(
        "DELETE FROM welcome_messages WHERE chat_id = ?",
        (chat_id,)
    )
    db.commit()


async def send_welcome_batch(chat_id: int):
    await asyncio.sleep(WELCOME_BATCH_DELAY)

    users = welcome_queue.pop(chat_id, [])

    if not users:
        return

    # Если капч сейчас нет — старые приветствия можно удалить
    if not captcha_exists(chat_id):
        await delete_all_welcomes(chat_id)

    mentions = []

    for user in users:
        mentions.append(
            mention_user(
                user.id,
                user.full_name
            )
        )

    users_text = ", ".join(mentions)

    text = (
        "👋 *Добро пожаловать в чат Stardrew Valley!*\n\n"
        f"{users_text}\n\n"
        "📖 [Правила](https://t.me/stardewrus_chat/1255258)"
    )

    try:
        message = await bot.send_message(
            chat_id=chat_id,
            text=text,
            parse_mode="Markdown",
            disable_web_page_preview=True
        )

        await save_welcome(
            chat_id,
            message.message_id
        )

    except Exception as e:
        logger.error(
            f"Ошибка приветствия: {e}"
        )


async def queue_welcome(chat_id: int, user):
    if chat_id not in welcome_queue:
        welcome_queue[chat_id] = []

    welcome_queue[chat_id].append(user)

    old_task = welcome_tasks.get(chat_id)

    if old_task and not old_task.done():
        old_task.cancel()

    task = asyncio.create_task(
        send_welcome_batch(chat_id)
    )

    welcome_tasks[chat_id] = task


