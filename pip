@dp.callback_query(
    F.data == "ttt_join"
)
async def join_game(
    callback: CallbackQuery
):

    # Ищем игру по message_id.
    message_id = callback.message.message_id

    game = games.get(
        message_id
    )

    if not game:

        await callback.answer(
            "Игра уже закончилась.",
            show_alert=True
        )

        return

    user = callback.from_user

    if user.id == game["creator_id"]:

        await callback.answer(
            "Вы уже создатель этой игры.",
            show_alert=True
        )

        return

    if game["player2_id"] is not None:

        await callback.answer(
            "В игре уже есть два игрока.",
            show_alert=True
        )

        return

    game["player2_id"] = user.id
    game["player2_name"] = user.full_name
    game["started"] = True

    # Создатель начинает ❌
    game["turn"] = game["creator_id"]

    await callback.message.edit_text(
        "🎮 <b>Крестики-нолики</b>\n\n"
        f"❌ {mention_user(game['creator_id'], game['creator_name'])}\n"
        f"⭕ {mention_user(game['player2_id'], game['player2_name'])}\n\n"
        "Игра началась!\n\n"
        f"{render_board(game['board'])}\n\n"
        f"Ход: ❌ "
        f"{mention_user(game['creator_id'], game['creator_name'])}",
        reply_markup=game_keyboard(
            game["board"],
            message_id
        )
    )

    await callback.answer(
        "Вы присоединились к игре!"
    )


