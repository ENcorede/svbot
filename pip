)
async def play_command(
    message: Message
):

    if message.chat.id != ALLOWED_CHAT_ID:
        return

    user = message.from_user

    game = Game(
        message_id=0,
        chat_id=message.chat.id,
        creator_id=user.id,
        creator_name=user.full_name
    )

    sent = await message.answer(
        "🎮 <b>КРЕСТИКИ-НОЛИКИ</b>\n\n"
        f"👤 {mention_user(user.id, user.full_name)}\n\n"
        "⏳ Ищем второго игрока...\n"
        "Осталось: <b>3:00</b>",
        parse_mode="HTML"
    )

    game.message_id = sent.message_id

    await sent.edit_reply_markup(
        reply_markup=waiting_game_keyboard(
            sent.message_id
        )
    )

    games[
        game.message_id
    ] = game

    game_timer_tasks[
        game.message_id
    ] = asyncio.create_task(
        game_timer(game)
    )


