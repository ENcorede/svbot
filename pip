# /MUT
# =========================================================

def parse_duration(value):

    value = value.lower().strip()

    match = re.fullmatch(
        r"(\d+)\s*(с|сек|секунд[аы]?|м|мин|минут[аы]?|ч|час|часа|часы|д|дн|день|дня|дней)",
        value
    )

    if not match:
        return None

    number = int(match.group(1))
    unit = match.group(2)

    if unit in {
        "с",
        "сек",
        "секунда",
        "секунды",
        "секунд"
    }:
        return timedelta(seconds=number)

    if unit in {
        "м",
        "мин",
        "минута",
        "минуты"
    }:
        return timedelta(minutes=number)

    if unit in {
        "ч",
        "час",
        "часа",
        "часы"
    }:
        return timedelta(hours=number)

    return timedelta(days=number)


def parse_mute(text):

    # Вариант:
    # /mut спам 1м
    parts = text.split()

    if len(parts) < 3:
        return None

    # Длительность — последний аргумент
    duration = parse_duration(
        parts[-1]
    )

    if duration:
        reason = " ".join(
            parts[1:-1]
        ).strip()

        if not reason:
            reason = "нарушение правил группы"

        return reason, duration

    # Вариант:
    # /mut спам 07.10.2026 09:00
    match = re.search(
        r"(\d{2}\.\d{2}\.\d{4})\s+(\d{2}:\d{2})\s*$",
        text
    )

    if not match:
        return None

    reason = text[
        4:match.start()
    ].strip()

    if not reason:
        reason = "нарушение правил группы"

    date_text = match.group(1)
    time_text = match.group(2)

    try:
        target = datetime.strptime(
            f"{date_text} {time_text}",
            "%d.%m.%Y %H:%M"
        ).replace(
            tzinfo=TIMEZONE
        )

        now = datetime.now(
            TIMEZONE
        )

        duration = target - now

        if duration.total_seconds() <= 0:
            return None

        return reason, duration

    except Exception:
        return None


@dp.message(
    Command("mut")
)
async def mute_command(
    message: Message
):

    if message.chat.id not in GROUPS:
        await safe_delete(message)
        return

    if not await is_group_admin(
        message.chat.id,
        message.from_user.id
    ):
        await safe_delete(message)
        return

    if not message.reply_to_message:
        await safe_delete(message)

        await send_bot_message(
            message.chat.id,
            "⚠️ Используй /mut ответом на сообщение пользователя."
        )
        return

    target = message.reply_to_message.from_user

    if await is_group_admin(
        message.chat.id,
        target.id
    ):
        await safe_delete(message)

        await send_bot_message(
            message.chat.id,
            "⚠️ Нельзя выдать ограничение администратору."
        )
        return

    parsed = parse_mute(
        message.text or ""
    )

    if not parsed:
        await safe_delete(message)

        await send_bot_message(
            message.chat.id,
            "⚠️ Формат:\n\n"
            "<code>/mut причина 1м</code>\n"
            "<code>/mut причина 30м</code>\n"
            "<code>/mut причина 2ч</code>\n"
            "<code>/mut причина 3д</code>\n\n"
            "Также можно указать точную дату:\n"
            "<code>/mut причина 07.10.2026 09:00</code>"
        )
        return

    reason, duration = parsed

    total_seconds = int(
        duration.total_seconds()
    )

    if total_seconds < 1:
        total_seconds = 1

    until = datetime.now(
        TIMEZONE
    ) + timedelta(
        seconds=total_seconds
    )

    # В Telegram передаём timezone-aware datetime.
    # Это исправляет проблему, когда минута превращалась
    # в несколько часов из-за неправильного timezone.
    try:

        await bot.restrict_chat_member(
            chat_id=message.chat.id,
            user_id=target.id,
            permissions=ChatPermissions(
                can_send_messages=False,
                can_send_audios=False,
                can_send_documents=False,
                can_send_photos=False,
                can_send_videos=False,
                can_send_video_notes=False,
                can_send_voice_notes=False,
                can_send_polls=False,
                can_send_other_messages=False,
                can_add_web_page_previews=False,
            ),
            until_date=until
        )

    except Exception as e:

        logger.exception(
            f"Ошибка /mut: {e}"
        )

        await safe_delete(message)

        await send_bot_message(
            message.chat.id,
            "❌ Не удалось выдать ограничение.\n"
            "Проверь права бота."
        )

        return

    increment_stat(
        message.chat.id,
        "mutes"
    )

    await safe_delete(message)

    days = total_seconds // 86400
    hours = total_seconds // 3600

    if days > 0:
        duration_text = (
            f"{days} дн. "
            f"({hours} ч / {total_seconds:,} сек)"
        )
    elif hours > 0:
        duration_text = (
            f"{hours} ч "
            f"({total_seconds:,} сек)"
        )
    else:
        minutes = total_seconds // 60

        if minutes > 0:
            duration_text = (
                f"{minutes} мин "
                f"({total_seconds:,} сек)"
            )
        else:
            duration_text = (
                f"{total_seconds} сек"
            )

    target_display = (
        f"@{target.username}"
        if target.username
        else target.full_name
    )

    await send_bot_message(
        message.chat.id,
        "🚫 <b>Пользователь получает ограничение</b>\n\n"
        f"👤 {html.escape(target_display)}\n"
        f"⏳ <b>Срок:</b> {duration_text}\n"
        f"📌 <b>Причина:</b> {html.escape(reason)}\n"
        f'📜 <b>Правила:</b> '
        f'<a href="{RULES_URL}">открыть</a>'
    )


