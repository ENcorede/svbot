@dp.chat_join_request()
async def join_request(
    request: ChatJoinRequest
):

    if request.chat.id != ALLOWED_CHAT_ID:
        return

    chat_id = request.chat.id
    user = request.from_user

    logger.info(
        f"Новая заявка: "
        f"{user.id} / {user.full_name}"
    )

    try:

        # СНАЧАЛА принимаем
        await request.approve()

        # Затем запрещаем писать
        await bot.restrict_chat_member(
            chat_id=chat_id,
            user_id=user.id,
            permissions=BLOCKED_PERMISSIONS
        )

        # Добавляем в очередь.
        # Если заявок несколько — они будут
        # объединены в одно сообщение.
        await queue_welcome(
            chat_id,
            user
        )

    except Exception as e:

        logger.exception(
            f"Ошибка обработки заявки: {e}"
        )


