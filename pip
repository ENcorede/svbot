            f"🧮 Активных капч: <b>{captcha_count}</b>\n"
            f"🚫 Слов в ЧС: <b>{blacklist_count}</b>"
        )

        await callback.message.edit_text(
            text,
            parse_mode="HTML",
            reply_markup=with_delete_button(
                InlineKeyboardMarkup(
                    inline_keyboard=[
                        [
                            InlineKeyboardButton(
                                text="‹ Назад",
                                callback_data=f"adminselect:group:{chat_id}"
                            )
                        ]
                    ]
                )
            )
        )

        await callback.answer()
        return

    # GLOBAL STATS
    if data == "admin:stats":

        rows = []

        for chat_id, title in GROUPS.items():

            stats = get_stats(chat_id)

            rows.append(
                f"<b>{html.escape(title)}</b>\n"
                f"📥 {stats['joins']} вступлений\n"
                f"🗑 {stats['messages_deleted']} удалений\n"
                f"🔇 {stats['mutes']} мутов\n"
                f"🚪 {stats['kicks']} киков\n"
                f"🔨 {stats['bans']} банов"
            )

        await callback.message.edit_text(
            "📊 <b>Общая статистика</b>\n\n"
            + "\n\n".join(rows),
            parse_mode="HTML",
            reply_markup=with_delete_button(
                back_keyboard()
            )
        )

        await callback.answer()
        return

    # GLOBAL MODERATION
    if data == "admin:moderation":

        await callback.message.edit_text(
            "🛡 <b>Модерация</b>\n\n"
            "Выбери группу.",
            parse_mode="HTML",
            reply_markup=with_delete_button(
                group_keyboard("adminmod")
            )
        )

        await callback.answer()
        return


