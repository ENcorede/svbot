def check_winner(board):

    combinations = [
        (0, 1, 2),
        (3, 4, 5),
        (6, 7, 8),

        (0, 3, 6),
        (1, 4, 7),
        (2, 5, 8),

        (0, 4, 8),
        (2, 4, 6)
    ]

    for a, b, c in combinations:

        if (
            board[a]
            and board[a] == board[b]
            and board[b] == board[c]
        ):
            return board[a]

    if all(board):
        return "draw"

    return None


def player_symbol(
    game: Game,
    user_id: int
):

    if user_id == game.creator_id:
        return "❌"

    if user_id == game.player2_id:
        return "⭕"

    return None


# =========================================================
# GAME TIMER
# =========================================================

async def game_timer(
    game: Game
):

    try:

        while True:

            if game.started:
                return

            elapsed = int(
                time.time() - game.created_at
            )

            remaining = GAME_WAIT_SECONDS - elapsed

            if remaining <= 0:

                games.pop(
                    game.message_id,
                    None
                )

                await bot.edit_message_text(
                    chat_id=game.chat_id,
                    message_id=game.message_id,
                    text=(
                        "🎮 <b>КРЕСТИКИ-НОЛИКИ</b>\n\n"
                        f"👤 {mention_user(game.creator_id, game.creator_name)}\n\n"
                        "⌛ Время ожидания второго игрока "
                        "<b>истекло</b>."
                    ),
                    parse_mode="HTML",
                    reply_markup=InlineKeyboardMarkup(
                        inline_keyboard=[
                            [
                                InlineKeyboardButton(
                                    text="🗑 Удалить",
                                    callback_data=(
                                        f"game:delete:"
                                        f"{game.message_id}"
                                    )
                                )
                            ]
                        ]
                    )
                )

                return

            minutes = remaining // 60
            seconds = remaining % 60

            timer = f"{minutes}:{seconds:02d}"

            try:

                await bot.edit_message_text(
                    chat_id=game.chat_id,
                    message_id=game.message_id,
                    text=(
                        "🎮 <b>КРЕСТИКИ-НОЛИКИ</b>\n\n"
                        f"👤 {mention_user(game.creator_id, game.creator_name)}\n\n"
                        f"⏳ Ищем второго игрока...\n"
                        f"Осталось: <b>{timer}</b>"
                    ),
                    parse_mode="HTML",
                    reply_markup=waiting_game_keyboard(
                        game.message_id
                    )
                )

            except Exception:
                pass

            await asyncio.sleep(1)

    except asyncio.CancelledError:
        return


