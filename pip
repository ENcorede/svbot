async def blacklist_text(
    chat_id,
):
    rows = db.execute(
        """
        SELECT word
        FROM blacklist
        WHERE chat_id = ?
        ORDER BY word
        """,
        (chat_id,),
    ).fetchall()

    if not rows:
        return "Пока слов нет."

    return "\n".join(
        f"• <code>{escape_text(row['word'])}</code>"
        for row in rows
    )


