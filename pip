def has_active_captchas(chat_id: int) -> bool:
    row = cursor.execute(
        """
        SELECT 1
        FROM captchas
        WHERE chat_id = ?
        LIMIT 1
        """,
        (chat_id,)
    ).fetchone()

    return row is not None


