def check_winner(board):

    combinations = [
        (0, 1, 2),
        (3, 4, 5),
        (6, 7, 8),

        (0, 3, 6),
        (1, 4, 7),
        (2, 5, 8),

        (0, 4, 8),
        (2, 4, 6),
    ]

    for a, b, c in combinations:

        if (
            board[a]
            and board[a] == board[b]
            and board[b] == board[c]
        ):
            return board[a]

    if all(board):
        return "draw"

    return None


def player_symbol(game: Game, user_id: int):

    if user_id == game.creator_id:
        return "❌"

    if user_id == game.player2_id:
        return "⭕"

    return None


async def game_timeout(message_id: int):

    await asyncio.sleep(GAME_WAIT_SECONDS)

    game = games.get(message_id)

    if not game:
        return

    if game.started:
        return

    try:
        await bot.edit_message_text(
            chat_id=game.chat_id,
            message_id=game.message_id,
            text=(
                "🎮 *Крестики-нолики*\n\n"
                f"👤 {mention_user(game.creator_id, game.creator_name)}\n\n"
                "⌛ Время ожидания второго игрока истекло."
            ),
            parse_mode="Markdown",
            reply_markup=InlineKeyboardMarkup(
                inline_keyboard=[
                    [
                        InlineKeyboardButton(
                            text="🗑 Удалить",
                            callback_data=f"game:delete:{message_id}"
                        )
                    ]
                ]
            )
        )

    except Exception:
        pass

    games.pop(message_id, None)


