# =========================================================

@dp.callback_query(
    F.data.startswith("game:move:")
)
async def game_move(
    callback: CallbackQuery
):

    try:

        parts = callback.data.split(":")

        message_id = int(parts[2])
        cell = int(parts[3])

    except Exception:

        await callback.answer(
            "Ошибка.",
            show_alert=True
        )

        return

    game = games.get(
        message_id
    )

    if not game:

        await callback.answer(
            "Игра закончилась.",
            show_alert=True
        )

        return

    if not game.started:

        await callback.answer(
            "Ждём второго игрока.",
            show_alert=True
        )

        return

    symbol = player_symbol(
        game,
        callback.from_user.id
    )

    if not symbol:

        await callback.answer(
            "Ты не участвуешь в этой игре.",
            show_alert=True
        )

        return

    expected_symbol = (
        "❌"
        if game.turn == 1
        else "⭕"
    )

    if symbol != expected_symbol:

        await callback.answer(
            "Сейчас ход другого игрока.",
            show_alert=True
        )

        return

    if game.board[cell]:

        await callback.answer(
            "Эта клетка занята.",
            show_alert=True
        )

        return

    game.board[cell] = symbol

    winner = check_winner(
        game.board
    )

    if winner:

        if winner == "draw":

            result = "🤝 <b>Ничья!</b>"

        elif winner == "❌":

            result = (
                "🏆 Победил "
                f"{mention_user(game.creator_id, game.creator_name)}!"
            )

        else:

            result = (
                "🏆 Победил "
                f"{mention_user(game.player2_id, game.player2_name)}!"
            )

        games.pop(
            message_id,
            None
        )

        await callback.message.edit_text(
            "🎮 <b>КРЕСТИКИ-НОЛИКИ</b>\n\n"
            f"❌ {mention_user(game.creator_id, game.creator_name)}\n"
            f"⭕ {mention_user(game.player2_id, game.player2_name)}\n\n"
            f"{result}",
            parse_mode="HTML",
            reply_markup=InlineKeyboardMarkup(
                inline_keyboard=[
                    [
                        InlineKeyboardButton(
                            text="🗑 Удалить",
                            callback_data=(
                                f"game:delete:"
                                f"{message_id}"
                            )
                        )
                    ]
                ]
            )
        )

        await callback.answer()

        return

    game.turn = (
        2
        if game.turn == 1
        else 1
    )

    next_symbol = (
        "❌"
        if game.turn == 1
        else "⭕"
    )

    await callback.message.edit_text(
        "🎮 <b>КРЕСТИКИ-НОЛИКИ</b>\n\n"
        f"❌ {mention_user(game.creator_id, game.creator_name)}\n"
        f"⭕ {mention_user(game.player2_id, game.player2_name)}\n\n"
        f"🔷 Ход: <b>{next_symbol}</b>",
        parse_mode="HTML",
        reply_markup=game_keyboard(game)
    )

    await callback.answer()


