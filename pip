@dp.chat_join_request()
async def join_request(request: ChatJoinRequest):

    if request.chat.id != ALLOWED_CHAT_ID:
        return

    user = request.from_user
    chat_id = request.chat.id

    logger.info(
        f"Новая заявка: {user.id} / {user.full_name}"
    )

    try:
        # Принимаем заявку
        await request.approve()

        # Сразу ограничиваем пользователя
        await restrict_user(
            chat_id,
            user.id
        )

        # Создаём персональную капчу
        question, answer, options = create_captcha()

        text = (
            f"🛡 *Проверка для {user.full_name}*\n\n"
            "Чтобы писать сообщения в чат, пройди небольшую проверку.\n\n"
            f"🔢 Сколько будет `{question}`?\n\n"
            "⚠️ Решить эту капчу может только тот пользователь, "
            "для которого она создана."
        )

        captcha_message = await bot.send_message(
            chat_id=chat_id,
            text=text,
            parse_mode="Markdown",
            reply_markup=captcha_keyboard(
                user.id,
                options
            )
        )

        db.execute(
            """
            INSERT OR REPLACE INTO captchas
            (
                chat_id,
                user_id,
                message_id,
                question,
                answer,
                created_at
            )
            VALUES (?, ?, ?, ?, ?, ?)
            """,
            (
                chat_id,
                user.id,
                captcha_message.message_id,
                question,
                answer,
                int(time.time())
            )
        )

        db.commit()

        await queue_welcome(
            chat_id,
            user
        )

    except Exception as e:
        logger.exception(
            f"Ошибка обработки заявки: {e}"
        )


