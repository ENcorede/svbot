def create_captcha():

    a = random.randint(1, 9)
    b = random.randint(1, 9)

    if random.choice([
        True,
        False,
    ]):
        question = f"{a} + {b}"
        answer = a + b

    else:
        if b > a:
            a, b = b, a

        question = f"{a} - {b}"
        answer = a - b

    options = {answer}

    while len(options) < 4:
        value = answer + random.randint(-5, 5)

        if value >= 0:
            options.add(value)

    options = list(options)

    random.shuffle(options)

    return (
        question,
        answer,
        options,
    )


def options_to_text(options):
    return ",".join(
        str(x)
        for x in options
    )


def text_to_options(text):
    return [
        int(x)
        for x in text.split(",")
        if x.strip()
    ]


def captcha_keyboard(rows):

    keyboard = []

    for row in rows:

        user_id = row["user_id"]

        options = text_to_options(
            row["options"]
        )

        keyboard.append([
            InlineKeyboardButton(
                text=f"👤 {user_id}",
                callback_data=(
                    f"captcha_info:{user_id}"
                ),
            )
        ])

        keyboard.append([
            InlineKeyboardButton(
                text=str(options[0]),
                callback_data=(
                    f"captcha:{user_id}:{options[0]}"
                ),
            ),
            InlineKeyboardButton(
                text=str(options[1]),
                callback_data=(
                    f"captcha:{user_id}:{options[1]}"
                ),
            ),
        ])

        keyboard.append([
            InlineKeyboardButton(
                text=str(options[2]),
                callback_data=(
                    f"captcha:{user_id}:{options[2]}"
                ),
            ),
            InlineKeyboardButton(
                text=str(options[3]),
                callback_data=(
                    f"captcha:{user_id}:{options[3]}"
                ),
            ),
        ])

    return InlineKeyboardMarkup(
        inline_keyboard=keyboard
    )


async def build_captcha_message(
    chat_id,
):
    rows = db.execute(
        """
        SELECT *
        FROM captchas
        WHERE chat_id = ?
        ORDER BY created_at
        """,
        (chat_id,),
    ).fetchall()

    if not rows:
        return None, None

    text = (
        "👋 <b>Добро пожаловать в Stardew Valley!</b>\n\n"
        "🌻 Общаемся, помогаем новичкам и вместе играем.\n"
        "Ознакомься с правилами и соблюдай их.\n\n"
    )

    for row in rows:

        try:
            member = await bot.get_chat_member(
                chat_id,
                row["user_id"],
            )

            user = member.user

            text += (
                f"👤 {display_user(user)}\n"
            )

        except Exception:
            text += "👤 Пользователь\n"

        text += (
            f"🧮 <code>{escape_text(row['question'])}</code> = ...\n"
            "Выбери ответ ниже.\n\n"
        )

    text += (
        "⚠️ Каждый участник может пройти "
        "только свою капчу."
    )

    return (
        text,
        captcha_keyboard(rows),
    )


