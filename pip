@dp.message(
    Command("mut")
)
async def mute_command(
    message: Message
):

    # Команда только в группе
    if message.chat.id != ALLOWED_CHAT_ID:
        await delete_command(message)
        return

    # Только администратор
    if not await is_admin(
        message.chat.id,
        message.from_user.id
    ):

        await delete_command(message)
        return

    # Обязательно ответом
    target = await get_replied_user(
        message
    )

    if not target:

        await delete_command(message)

        await message.answer(
            "⚠️ Команду /mut нужно использовать "
            "ответом на сообщение пользователя."
        )

        return

    # Аргументы после /mut
    args = message.text.split(maxsplit=1)

    if len(args) < 2:

        await delete_command(message)

        await message.answer(
            "⚠️ Формат:\n\n"
            "<code>/mut причина 07.10.2026 09:00</code>",
            parse_mode="HTML"
        )

        return

    data = args[1].strip()

    # Ищем дату и время в конце команды
    match = re.search(
        r"(\d{2}\.\d{2}\.\d{4})\s+(\d{2}:\d{2})\s*$",
        data
    )

    if not match:

        await delete_command(message)

        await message.answer(
            "⚠️ Не удалось определить дату.\n\n"
            "Пример:\n"
            "<code>/mut нарушение правил "
            "07.10.2026 09:00</code>",
            parse_mode="HTML"
        )

        return

    date_text = match.group(1)
    time_text = match.group(2)

    reason = data[
        :match.start()
    ].strip()

    if not reason:
        reason = "нарушение правил группы"

    # Парсим дату
    try:

        until = datetime.strptime(
            f"{date_text} {time_text}",
            "%d.%m.%Y %H:%M"
        )

        until_timestamp = until.timestamp()

    except ValueError:

        await delete_command(message)

        await message.answer(
            "⚠️ Неверная дата или время.",
        )

        return

    now = time.time()

    if until_timestamp <= now:

        await delete_command(message)

        await message.answer(
            "⚠️ Дата окончания мута уже прошла."
        )

        return

    # Нельзя мутить администратора
    if await is_admin(
        message.chat.id,
        target.id
    ):

        await delete_command(message)

        await message.answer(
            "⚠️ Нельзя выдать мут администратору."
        )

        return

    seconds = int(
        until_timestamp - now
    )

    days = seconds // 86400
    hours = seconds // 3600
    remaining_seconds = seconds

    # Telegram ограничивает срок мута,
    # но здесь используем указанное пользователем время.
    try:

        await bot.restrict_chat_member(
            chat_id=message.chat.id,
            user_id=target.id,
            permissions=BLOCKED_PERMISSIONS,
            until_date=until
        )

    except Exception as e:

        logger.error(
            f"Ошибка мута: {e}"
        )

        await delete_command(message)

        await message.answer(
            "❌ Не удалось выдать ограничение.\n"
            "Проверь права бота."
        )

        return

    await delete_command(message)

    target_name = (
        f"@{target.username}"
        if target.username
        else target.full_name
    )

    mute_text = (
        "🚫 <b>Пользователь "
        f"{html.escape(target_name)} "
        "получает ограничение</b>\n\n"
        f"⏳ <b>Срок:</b> {days} дней "
        f"({hours} часов / {remaining_seconds:,} секунд)\n"
        f"📌 <b>Причина:</b> {html.escape(reason)}\n"
        f"📜 <b>Правила:</b> "
        f'<a href="{RULES_URL}">правила группы</a>'
    )

    await message.answer(
        mute_text,
        parse_mode="HTML",
        disable_web_page_preview=True
    )


