@dp.message(
    F.chat.type.in_({
        "group",
        "supergroup"
    })
)
async def group_message_filter(
    message: Message
):

    chat_id = message.chat.id

    if not is_managed_group(chat_id):
        return

    # Все команды пропускаем.
    # Они обрабатываются отдельными handlers.
    if message.text and message.text.startswith("/"):
        return

    # Админы не попадают под ограничения.
    if await is_group_admin(
        chat_id,
        message.from_user.id
    ):
        return

    # -------------------------
    # READ ONLY
    # -------------------------

    if get_setting(
        chat_id,
        "readonly",
        0
    ):

        await safe_delete(message)

        increment_stat(
            chat_id,
            "messages_deleted"
        )

        return

    # -------------------------
    # BLACKLIST
    # -------------------------

    rows = db.execute(
        """
        SELECT word
        FROM blacklist
        WHERE chat_id = ?
        ORDER BY LENGTH(word) DESC
        """,
        (chat_id,)
    ).fetchall()

    if not rows:
        return

    content = (
        message.text
        or message.caption
        or ""
    ).lower()

    for row in rows:

        if row["word"].lower() in content:

            await safe_delete(message)

            increment_stat(
                chat_id,
                "messages_deleted"
            )

            return


