@dp.callback_query(
    F.data.startswith("captcha:")
)
async def captcha_handler(
    callback: CallbackQuery
):

    try:

        _, user_id_text, answer_text = (
            callback.data.split(":")
        )

        user_id = int(user_id_text)
        selected = int(answer_text)

    except Exception:
        return

    if callback.from_user.id != user_id:

        await callback.answer(
            "Это не твоя капча.",
            show_alert=True
        )

        return

    chat_id = callback.message.chat.id

    row = db.execute(
        """
        SELECT *
        FROM captchas
        WHERE chat_id = ?
        AND user_id = ?
        """,
        (
            chat_id,
            user_id
        )
    ).fetchone()

    if not row:

        await callback.answer(
            "Капча уже пройдена."
        )

        return

    if selected != row["answer"]:

        await callback.answer(
            "Неверный ответ.",
            show_alert=True
        )

        return

    db.execute(
        """
        DELETE FROM captchas
        WHERE chat_id = ?
        AND user_id = ?
        """,
        (
            chat_id,
            user_id
        )
    )

    db.commit()

    try:

        await bot.restrict_chat_member(
            chat_id=chat_id,
            user_id=user_id,
            permissions=ChatPermissions(
                can_send_messages=True,
                can_send_audios=True,
                can_send_documents=True,
                can_send_photos=True,
                can_send_videos=True,
                can_send_video_notes=True,
                can_send_voice_notes=True,
                can_send_polls=True,
                can_send_other_messages=True,
                can_add_web_page_previews=True,
            )
        )

    except Exception as e:

        logger.error(
            f"Captcha unrestrict error: {e}"
        )

    remaining = db.execute(
        """
        SELECT COUNT(*)
        FROM captchas
        WHERE chat_id = ?
        """,
        (chat_id,)
    ).fetchone()[0]

    if remaining == 0:

        await delete_welcome_messages(
            chat_id
        )

    else:

        text, keyboard = await build_captcha_message(
            chat_id
        )

        try:

            await callback.message.edit_text(
                text,
                parse_mode="HTML",
                disable_web_page_preview=True,
                reply_markup=add_delete_button(
                    keyboard
                )
            )

        except Exception:
            pass

    await callback.answer(
        "Капча пройдена!"
    )


# =========================================================
# ЧЁРНЫЙ СПИСОК
# =========================================================

def normalize_blacklist_word(word: str) -> str:

    # Убираем пробелы по краям
    word = word.strip()

    # Несколько пробелов превращаем в один
    word = re.sub(
        r"\s+",
        " ",
        word
    )

    # Регистр игнорируется
    return word.casefold()


def get_blacklist_words(chat_id: int):

    rows = db.execute(
        """
        SELECT word
        FROM blacklist
        WHERE chat_id = ?
        ORDER BY word COLLATE NOCASE
        """,
        (chat_id,)
    ).fetchall()

    return [
        row["word"]
        for row in rows
    ]


def message_content_for_blacklist(
    message: Message
) -> str:

    parts = []

    if message.text:
        parts.append(message.text)

    if message.caption:
        parts.append(message.caption)

    # Telegram может прислать несколько типов
    # медиа. Caption уже содержит текст подписи,
    # поэтому этого достаточно для проверки.
    return "\n".join(parts)


def contains_blacklisted_word(
    chat_id: int,
    message: Message
) -> str | None:

    content = message_content_for_blacklist(
        message
    )

    if not content:
        return None

    content = content.casefold()

    words = get_blacklist_words(
        chat_id
    )

    for word in words:

        normalized = normalize_blacklist_word(
            word
        )

        if not normalized:
            continue

        # Для фразы проверяем обычное вхождение.
        if " " in normalized:

            if normalized in content:
                return word

        else:

            # Отдельное слово.
            #
            # Например:
            # "слово" -> сработает
            # "СЛОВО" -> сработает
            #
            # При этом случайные части других слов
            # стараемся не ловить.
            pattern = (
                r"(?<![A-Za-zА-Яа-яЁё0-9_])"
                + re.escape(normalized)
                + r"(?![A-Za-zА-Яа-яЁё0-9_])"
            )

            if re.search(
                pattern,
                content,
                flags=re.IGNORECASE
            ):
                return word

    return None


# =========================================================
# ГЛАВНЫЙ ФИЛЬТР СООБЩЕНИЙ
# =========================================================

@dp.message(
    F.chat.type.in_({
        "group",
        "supergroup"
    })
)
async def group_message_filter(
    message: Message
):

    chat_id = message.chat.id

    if not is_managed_group(chat_id):
        return

    # -----------------------------------------------------
    # Команды пропускаем.
    # -----------------------------------------------------

    if message.text and message.text.startswith("/"):
        return

    # -----------------------------------------------------
    # Администраторы не попадают под ЧС и RO.
    # -----------------------------------------------------

    if await is_group_admin(
        chat_id,
        message.from_user.id
    ):
        return

    # -----------------------------------------------------
    # ЧЁРНЫЙ СПИСОК
    #
    # Проверяется ДО RO.
    # -----------------------------------------------------

    bad_word = contains_blacklisted_word(
        chat_id,
        message
    )

    if bad_word:

        await safe_delete(message)

        increment_stat(
            chat_id,
            "messages_deleted"
        )

        logger.info(
            f"Удалено сообщение в {chat_id}: "
            f"найдено ключевое слово '{bad_word}'"
        )

        return

    # -----------------------------------------------------
    # READ ONLY
    # -----------------------------------------------------

    if get_setting(
        chat_id,
        "readonly",
        0
    ):

        await safe_delete(message)

        increment_stat(
            chat_id,
            "messages_deleted"
        )

        return


