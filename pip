@dp.callback_query(
    F.data.startswith("game:join:")
)
async def game_join(
    callback: CallbackQuery
):

    try:

        message_id = int(
            callback.data.split(":")[2]
        )

    except Exception:

        await callback.answer(
            "Ошибка игры.",
            show_alert=True
        )

        return

    game = games.get(
        message_id
    )

    if not game:

        await callback.answer(
            "❌ Игра уже закончилась.",
            show_alert=True
        )

        return

    if game.started:

        await callback.answer(
            "❌ Игра уже началась.",
            show_alert=True
        )

        return

    if callback.from_user.id == game.creator_id:

        await callback.answer(
            "Ты уже создал эту игру.",
            show_alert=True
        )

        return

    # Подключаем второго игрока
    game.player2_id = callback.from_user.id
    game.player2_name = callback.from_user.full_name
    game.started = True
    game.turn = 1

    # Останавливаем таймер
    timer_task = game_timer_tasks.pop(
        message_id,
        None
    )

    if timer_task:
        timer_task.cancel()

    try:

        await callback.message.edit_text(
            "🎮 <b>КРЕСТИКИ-НОЛИКИ</b>\n\n"
            f"❌ {mention_user(game.creator_id, game.creator_name)}\n"
            f"⭕ {mention_user(game.player2_id, game.player2_name)}\n\n"
            "🔷 Ход: <b>❌</b>",
            parse_mode="HTML",
            reply_markup=game_keyboard(game)
        )

    except Exception as e:

        logger.error(
            f"Ошибка входа в игру: {e}"
        )

        await callback.answer(
            "❌ Не удалось начать игру.",
            show_alert=True
        )

        return

    await callback.answer(
        "🎮 Ты вошёл в игру!"
    )


