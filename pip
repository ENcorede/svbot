@dp.callback_query(
    F.data.startswith("ttt:")
)
async def ttt_move(
    callback: CallbackQuery
):

    try:

        _, message_id, index = callback.data.split(":")

        message_id = int(message_id)
        index = int(index)

    except Exception:

        await callback.answer(
            "Ошибка.",
            show_alert=True
        )

        return

    game = games.get(
        message_id
    )

    if not game:

        await callback.answer(
            "Игра закончилась.",
            show_alert=True
        )

        return

    if not game["started"]:

        await callback.answer(
            "Сначала нужен второй игрок.",
            show_alert=True
        )

        return

    user_id = callback.from_user.id

    if user_id != game["turn"]:

        await callback.answer(
            "Сейчас ход другого игрока.",
            show_alert=True
        )

        return

    if game["board"][index] != "":

        await callback.answer(
            "Эта клетка уже занята.",
            show_alert=True
        )

        return

    if user_id == game["creator_id"]:
        symbol = "❌"
        next_player = game["player2_id"]
    else:
        symbol = "⭕"
        next_player = game["creator_id"]

    game["board"][index] = symbol
    game["turn"] = next_player

    winner = check_winner(
        game["board"]
    )

    if winner:

        if winner == "draw":
            result = "🤝 Ничья!"
        elif winner == "❌":
            result = (
                "🏆 Победил "
                + mention_user(
                    game["creator_id"],
                    game["creator_name"]
                )
                + "!"
            )
        else:
            result = (
                "🏆 Победил "
                + mention_user(
                    game["player2_id"],
                    game["player2_name"]
                )
                + "!"
            )

        await callback.message.edit_text(
            "🎮 <b>Крестики-нолики</b>\n\n"
            f"{render_board(game['board'])}\n\n"
            f"{result}",
            reply_markup=InlineKeyboardMarkup(
                inline_keyboard=[
                    [
                        InlineKeyboardButton(
                            text="🔴 Удалить",
                            callback_data=f"ttt_delete:{message_id}"
                        )
                    ]
                ]
            )
        )

        await callback.answer(
            "Игра окончена!"
        )

        return

    next_symbol = (
        "❌"
        if game["turn"] == game["creator_id"]
        else "⭕"
    )

    next_name = (
        game["creator_name"]
        if game["turn"] == game["creator_id"]
        else game["player2_name"]
    )

    await callback.message.edit_text(
        "🎮 <b>Крестики-нолики</b>\n\n"
        f"❌ {mention_user(game['creator_id'], game['creator_name'])}\n"
        f"⭕ {mention_user(game['player2_id'], game['player2_name'])}\n\n"
        f"{render_board(game['board'])}\n\n"
        f"Ход: {next_symbol} "
        f"{mention_user(game['turn'], next_name)}",
        reply_markup=game_keyboard(
            game["board"],
            message_id
        )
    )

    await callback.answer()


