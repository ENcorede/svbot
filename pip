def generate_drop():

    season = random.choice(
        DROP_SEASONS
    )

    location = random.choice(
        DROP_LOCATIONS
    )

    item = random.choice(
        DROP_ITEMS
    )

    weather = random.choice(
        DROP_WEATHER
    )

    luck = random.randint(
        1,
        100
    )

    return (
        "💧 <b>КАПЛЯ STARDEW</b>\n\n"
        f"{season}\n"
        f"{weather}\n"
        f"{location}\n\n"
        f"🎁 Находка: <b>{item}</b>\n"
        f"🍀 Удача: <b>{luck}%</b>\n\n"
        "Нажми кнопку для новой комбинации."
    )


def drop_keyboard():

    return InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(
                    text="💧 Новая капля",
                    callback_data="drop:new"
                )
            ]
        ]
    )


@dp.message(Command("drop"))
async def drop_command(
    message: Message
):

    if message.chat.id != ALLOWED_CHAT_ID:
        return

    await message.answer(
        generate_drop(),
        parse_mode="HTML",
        reply_markup=drop_keyboard()
    )


@dp.callback_query(
    F.data == "drop:new"
)
async def new_drop(
    callback: CallbackQuery
):

    if callback.message.chat.id != ALLOWED_CHAT_ID:
        return

    await callback.message.edit_text(
        generate_drop(),
        parse_mode="HTML",
        reply_markup=drop_keyboard()
    )

    await callback.answer(
        "💧 Новая комбинация!"
    )


