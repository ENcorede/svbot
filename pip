@dp.callback_query(
    F.data.startswith("black_delete:")
)
async def black_delete_callback(
    callback: CallbackQuery
):

    if not is_bot_admin(
        callback.from_user.id
    ):
        return

    chat_id = int(
        callback.data.split(":")[1]
    )

    words = get_blacklist_words(
        chat_id
    )

    buttons = []

    for word in words:

        # Ограничиваем размер callback_data.
        # Сами слова при этом полностью сохраняются
        # в БД.
        if len(word) > 40:
            label = word[:37] + "..."
        else:
            label = word

        # Base64 здесь не нужен:
        # для обычных слов Telegram callback выдержит.
        # Используем безопасную замену разделителя.
        safe_word = word.replace(
            ":",
            "∶"
        )

        buttons.append([
            InlineKeyboardButton(
                text=f"× {label}",
                callback_data=(
                    f"black_remove:{chat_id}:{safe_word}"
                )
            )
        ])

    if not buttons:

        buttons.append([
            InlineKeyboardButton(
                text="‹ Назад",
                callback_data=f"admin_blacklist:{chat_id}"
            )
        ])

    else:

        buttons.append([
            InlineKeyboardButton(
                text="‹ Назад",
                callback_data=f"admin_blacklist:{chat_id}"
            )
        ])

    await callback.message.edit_text(
        "− <b>Удаление ключевого слова</b>\n\n"
        "Выбери слово:",
        parse_mode="HTML",
        reply_markup=add_delete_button(
            InlineKeyboardMarkup(
                inline_keyboard=buttons
            )
        )
    )

    await callback.answer()


@dp.callback_query(
    F.data.startswith("black_remove:")
)
async def black_remove_callback(
    callback: CallbackQuery
):

    if not is_bot_admin(
        callback.from_user.id
    ):
        return

    parts = callback.data.split(
        ":",
        2
    )

    if len(parts) != 3:
        return

    chat_id = int(
        parts[1]
    )

    word = parts[2].replace(
        "∶",
        ":"
    )

    db.execute(
        """
        DELETE FROM blacklist
        WHERE chat_id = ?
        AND word = ?
        """,
        (
            chat_id,
            word
        )
    )

    db.commit()

    await callback.answer(
        "Ключевое слово удалено."
    )

    words = get_blacklist_words(
        chat_id
    )

    text = (
        f"🚫 <b>Чёрный список</b>\n"
        f"{escape_text(group_title(chat_id))}\n\n"
        f"Всего слов: <b>{len(words)}</b>\n\n"
        f"{blacklist_text(chat_id)}"
    )

    await callback.message.edit_text(
        text,
        parse_mode="HTML",
        reply_markup=add_delete_button(
            blacklist_menu_keyboard(chat_id)
        )
    )


