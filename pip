@dp.chat_join_request()
async def join_request(
    request: ChatJoinRequest
):

    if request.chat.id != ALLOWED_CHAT_ID:
        return

    chat_id = request.chat.id
    user = request.from_user

    logger.info(
        f"Новая заявка: "
        f"{user.id} / {user.full_name}"
    )

    try:

        # 1. СНАЧАЛА принимаем
        await request.approve()

        # 2. Сразу ограничиваем писать
        await restrict_user(
            chat_id,
            user.id
        )

        # 3. Добавляем в очередь
        # Приветствие + капча будут ОДНИМ сообщением
        await queue_welcome(
            chat_id,
            user
        )

    except Exception as e:

        logger.exception(
            f"Ошибка заявки: {e}"
        )


