]

DROP_ITEMS = [
    "🥔 Картошка",
    "🍓 Клубника",
    "🫐 Черника",
    "🍄 Лисичка",
    "💎 Алмаз",
    "🪨 Камень",
    "🌾 Пшеница",
    "🐟 Рыба",
    "🥚 Яйцо"
]

DROP_WEATHER = [
