def ensure_chat_settings(chat_id: int):

    db.execute(
        """
        INSERT OR IGNORE INTO settings
        (chat_id, readonly, captcha_enabled)
        VALUES (?, 0, 1)
        """,
        (chat_id,),
    )

    db.execute(
        """
        INSERT OR IGNORE INTO statistics
        (chat_id, joins, messages_deleted, mutes, bans, kicks)
        VALUES (?, 0, 0, 0, 0, 0)
        """,
        (chat_id,),
    )

    db.commit()


def get_setting(
    chat_id: int,
    setting: str,
    default=0,
):
    allowed = {
        "readonly",
        "captcha_enabled",
    }

    if setting not in allowed:
        return default

    ensure_chat_settings(chat_id)

    row = db.execute(
        f"""
        SELECT {setting}
        FROM settings
        WHERE chat_id = ?
        """,
        (chat_id,),
    ).fetchone()

    if not row:
        return default

    return row[setting]


def set_setting(
    chat_id: int,
    setting: str,
    value,
):
    allowed = {
        "readonly",
        "captcha_enabled",
    }

    if setting not in allowed:
        return

    ensure_chat_settings(chat_id)

    db.execute(
        f"""
        UPDATE settings
        SET {setting} = ?
        WHERE chat_id = ?
        """,
        (
            value,
            chat_id,
        ),
    )

    db.commit()


def increment_stat(
    chat_id: int,
    field: str,
):
    allowed = {
        "joins",
        "messages_deleted",
        "mutes",
        "bans",
        "kicks",
    }

    if field not in allowed:
        return

    ensure_chat_settings(chat_id)

    db.execute(
        f"""
        UPDATE statistics
        SET {field} = {field} + 1
        WHERE chat_id = ?
        """,
        (chat_id,),
    )

    db.commit()


def get_stats(chat_id: int):
    ensure_chat_settings(chat_id)

    row = db.execute(
        """
        SELECT *
        FROM statistics
        WHERE chat_id = ?
        """,
        (chat_id,),
    ).fetchone()

    return dict(row)


