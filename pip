@dp.callback_query(F.data.startswith("game:move:"))
async def game_move(callback: CallbackQuery):

    try:
        parts = callback.data.split(":")
        message_id = int(parts[2])
        cell = int(parts[3])

    except Exception:
        await callback.answer("Ошибка.")
        return

    game = games.get(message_id)

    if not game:
        await callback.answer(
            "Игра не найдена.",
            show_alert=True
        )
        return

    if not game.started:
        await callback.answer(
            "Сначала должен подключиться второй игрок.",
            show_alert=True
        )
        return

    symbol = player_symbol(
        game,
        callback.from_user.id
    )

    if not symbol:
        await callback.answer(
            "Ты не участвуешь в этой игре.",
            show_alert=True
        )
        return

    expected_symbol = (
        "❌"
        if game.turn == 1
        else "⭕"
    )

    if symbol != expected_symbol:
        await callback.answer(
            "Сейчас ход другого игрока.",
            show_alert=True
        )
        return

    if game.board[cell]:
        await callback.answer(
            "Эта клетка уже занята.",
            show_alert=True
        )
        return

    game.board[cell] = symbol

    winner = check_winner(
        game.board
    )

    if winner:

        if winner == "draw":
            result = "🤝 Ничья!"
        elif winner == "❌":
            result = (
                f"🏆 Победил "
                f"{mention_user(game.creator_id, game.creator_name)}!"
            )
        else:
            result = (
                f"🏆 Победил "
                f"{mention_user(game.player2_id, game.player2_name)}!"
            )

        await callback.message.edit_text(
            "🎮 *КРЕСТИКИ-НОЛИКИ*\n\n"
            f"❌ {mention_user(game.creator_id, game.creator_name)}\n"
            f"⭕ {mention_user(game.player2_id, game.player2_name)}\n\n"
            f"{result}",
            parse_mode="Markdown",
            reply_markup=InlineKeyboardMarkup(
                inline_keyboard=[
                    [
                        InlineKeyboardButton(
                            text="🗑 Удалить",
                            callback_data=f"game:delete:{message_id}"
                        )
                    ]
                ]
            )
        )

        games.pop(message_id, None)

        await callback.answer()
        return

    # Передаём ход
    game.turn = 2 if game.turn == 1 else 1

    next_symbol = (
        "❌"
        if game.turn == 1
        else "⭕"
    )

    await callback.message.edit_text(
        "🎮 *КРЕСТИКИ-НОЛИКИ*\n\n"
        f"❌ {mention_user(game.creator_id, game.creator_name)}\n"
        f"⭕ {mention_user(game.player2_id, game.player2_name)}\n\n"
        f"Ход: {next_symbol}",
        parse_mode="Markdown",
        reply_markup=game_keyboard(game)
    )

    await callback.answer()


