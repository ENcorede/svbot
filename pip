def create_captcha():

    a = random.randint(1, 9)
    b = random.randint(1, 9)

    if random.choice([True, False]):

        question = f"{a} + {b}"
        answer = a + b

    else:

        if b > a:
            a, b = b, a

        question = f"{a} - {b}"
        answer = a - b

    options = {answer}

    while len(options) < 4:

        value = answer + random.randint(
            -5,
            5
        )

        if value >= 0:
            options.add(value)

    options = list(options)

    random.shuffle(options)

    return (
        question,
        answer,
        options
    )


def options_to_text(options):
    return ",".join(
        str(x)
        for x in options
    )


def text_to_options(text):
    return [
        int(x)
        for x in text.split(",")
        if x
    ]


def captcha_keyboard(rows):

    keyboard = []

    for row in rows:

        user_id = row["user_id"]
        options = text_to_options(
            row["options"]
        )

        keyboard.append([
            InlineKeyboardButton(
                text="🔐 Капча пользователя",
                callback_data=(
                    f"captcha_info:{user_id}"
                )
            )
        ])

        keyboard.append([
            InlineKeyboardButton(
                text=str(options[0]),
                callback_data=(
                    f"captcha:{user_id}:{options[0]}"
                )
            ),
            InlineKeyboardButton(
                text=str(options[1]),
                callback_data=(
                    f"captcha:{user_id}:{options[1]}"
                )
            )
        ])

        keyboard.append([
            InlineKeyboardButton(
                text=str(options[2]),
                callback_data=(
                    f"captcha:{user_id}:{options[2]}"
                )
            ),
            InlineKeyboardButton(
                text=str(options[3]),
                callback_data=(
                    f"captcha:{user_id}:{options[3]}"
                )
            )
        ])

    return InlineKeyboardMarkup(
        inline_keyboard=keyboard
    )


async def build_captcha_message(chat_id):

    rows = db.execute(
        """
        SELECT *
        FROM captchas
        WHERE chat_id = ?
        ORDER BY created_at
        """,
        (chat_id,)
    ).fetchall()

    if not rows:
        return None, None

    text = (
        "👋 <b>Добро пожаловать в Stardew Valley!</b>\n\n"
        "🌻 Общаемся, помогаем новичкам и вместе играем.\n"
        "Ознакомься с правилами и соблюдай их.\n\n"
    )

    for row in rows:

        try:

            member = await bot.get_chat_member(
                chat_id,
                row["user_id"]
            )

            user = member.user

            text += (
                f"👤 {display_user(user)}\n"
            )

        except Exception:

            text += "👤 Пользователь\n"

        text += (
            f"🧮 <code>{escape_text(row['question'])}</code> = ...\n"
            "Выбери ответ ниже.\n\n"
        )

    text += (
        "⚠️ Каждый участник может пройти "
        "только свою капчу."
    )

    return (
        text,
        captcha_keyboard(rows)
    )


async def delete_welcome_messages(
    chat_id
):

    rows = db.execute(
        """
        SELECT message_id
        FROM welcome_messages
        WHERE chat_id = ?
        """,
        (chat_id,)
    ).fetchall()

    for row in rows:

        try:

            await bot.delete_message(
                chat_id,
                row["message_id"]
            )

        except Exception:
            pass

    db.execute(
        """
        DELETE FROM welcome_messages
        WHERE chat_id = ?
        """,
        (chat_id,)
    )

    db.commit()


async def send_welcome_batch(
    chat_id
):

    await asyncio.sleep(1.5)

    users = welcome_queue.pop(
        chat_id,
        []
    )

    if not users:
        return

    for user in users:

        question, answer, options = create_captcha()

        db.execute(
            """
            INSERT OR REPLACE INTO captchas
            (
                chat_id,
                user_id,
                question,
                answer,
                options,
                created_at
            )
            VALUES (?, ?, ?, ?, ?, ?)
            """,
            (
                chat_id,
                user.id,
                question,
                answer,
                options_to_text(options),
                int(time.time())
            )
        )

    db.commit()

    text, keyboard = await build_captcha_message(
        chat_id
    )

    if not text:
        return

    try:

        message = await send_bot_message(
            chat_id,
            text,
            keyboard
        )

    except Exception as e:

        logger.exception(
            f"CAPTCHA error: {e}"
        )
        return

    db.execute(
        """
        INSERT OR IGNORE INTO welcome_messages
        (chat_id, message_id)
        VALUES (?, ?)
        """,
        (
            chat_id,
            message.message_id
        )
    )

    db.commit()


async def queue_welcome(
    chat_id,
    user
):

    if chat_id not in welcome_queue:
        welcome_queue[chat_id] = []

    welcome_queue[chat_id].append(
        user
    )

    old_task = welcome_tasks.get(
        chat_id
    )

    if old_task and not old_task.done():
        old_task.cancel()

    welcome_tasks[chat_id] = (
        asyncio.create_task(
            send_welcome_batch(chat_id)
        )
    )


