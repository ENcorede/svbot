@dp.callback_query(
    F.data == "ttt_delete_pending"
)
async def delete_pending_game(
    callback: CallbackQuery
):

    message_id = callback.message.message_id

    game = games.get(
        message_id
    )

    if not game:

        await callback.answer(
            "Игра уже удалена.",
            show_alert=True
        )

        return

    user_id = callback.from_user.id

    allowed = (
        user_id == game["creator_id"]
        or await user_is_moderator(
            game["chat_id"],
            user_id
        )
    )

    if not allowed:

        await callback.answer(
            "Удалить игру может создатель или модератор.",
            show_alert=True
        )

        return

    await delete_game_message(
        game["chat_id"],
        message_id
    )

    await callback.answer(
        "Игра удалена."
    )


@dp.callback_query(
    F.data.startswith("ttt_delete:")
)
async def delete_game(
    callback: CallbackQuery
):

    try:
        _, message_id = callback.data.split(":")

        message_id = int(message_id)

    except Exception:

        await callback.answer(
            "Ошибка.",
            show_alert=True
        )

        return

    game = games.get(
        message_id
    )

    if not game:

        try:
            await callback.message.delete()
        except TelegramBadRequest:
            pass

        await callback.answer(
            "Удалено."
        )

        return

    user_id = callback.from_user.id

    allowed = (
        user_id == game["creator_id"]
        or await user_is_moderator(
            game["chat_id"],
            user_id
        )
    )

    if not allowed:

        await callback.answer(
            "Удалить игру может создатель или модератор.",
            show_alert=True
        )

        return

    await delete_game_message(
        game["chat_id"],
        message_id
    )

    await callback.answer(
        "Игра удалена."
    )


