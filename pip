@dp.message(
    F.chat.type == ChatType.PRIVATE
)
async def private_messages(
    message: Message,
):
    user_id = message.from_user.id

    if not is_bot_admin(user_id):
        return

    # /admin обрабатывается отдельным handler.
    if message.text and message.text.startswith("/"):
        return

    state = admin_states.get(
        user_id
    )

    if not state:
        return

    if state.get("action") != "blacklist_add":
        return

    chat_id = state.get(
        "selected_group"
    )

    private_chat_id = state.get(
        "private_chat_id"
    )

    panel_message_id = state.get(
        "message_id"
    )

    if not chat_id:
        return

    words = [
        word.strip().lower()
        for word in (
            message.text or ""
        ).splitlines()
        if word.strip()
    ]

    words = list(
        dict.fromkeys(words)
    )

    if not words:

        await safe_delete(message)

        try:
            await bot.edit_message_text(
                chat_id=private_chat_id,
                message_id=panel_message_id,
                text=(
                    "⚠️ <b>Ничего не добавлено.</b>\n\n"
                    "Отправь хотя бы одно слово."
                ),
                parse_mode="HTML",
                reply_markup=add_delete_button(
                    InlineKeyboardMarkup(
                        inline_keyboard=[
                            [
                                InlineKeyboardButton(
                                    text="‹ Назад",
                                    callback_data=(
                                        f"admin_blacklist:{chat_id}"
                                    ),
                                )
                            ]
                        ]
                    )
                ),
            )
        except Exception:
            pass

        return

    for word in words:

        # Не даём добавить слишком длинные значения.
        if len(word) > 100:
            continue

        db.execute(
            """
            INSERT OR IGNORE INTO blacklist
            (chat_id, word)
            VALUES (?, ?)
            """,
            (
                chat_id,
                word,
            ),
        )

    db.commit()

    await safe_delete(message)

    words_text = await blacklist_text(
        chat_id
    )

    try:

        await bot.edit_message_text(
            chat_id=private_chat_id,
            message_id=panel_message_id,
            text=(
                f"🚫 <b>Чёрный список — "
                f"{escape_text(group_title(chat_id))}</b>\n\n"
                f"{words_text}\n\n"
                "✅ Список обновлён."
            ),
            parse_mode="HTML",
            reply_markup=add_delete_button(
                blacklist_menu_keyboard(chat_id)
            ),
        )

    except Exception as e:

        logger.error(
            f"Blacklist panel edit error: {e}"
        )

    state["action"] = None


