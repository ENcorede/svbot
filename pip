def create_captcha():

    operations = [
        ("2 + 3", 5),
        ("4 + 4", 8),
        ("7 - 3", 4),
        ("5 + 6", 11),
        ("9 - 4", 5),
        ("3 × 3", 9),
        ("6 + 7", 13),
        ("10 - 6", 4),
        ("8 + 5", 13),
        ("12 - 7", 5),
    ]

    question, correct = random.choice(operations)

    answers = {correct}

    while len(answers) < 4:
        offset = random.randint(-5, 5)

        if offset == 0:
            continue

        value = correct + offset

        if value > 0:
            answers.add(value)

    answers = list(answers)
    random.shuffle(answers)

    return question, correct, answers


def captcha_keyboard(
    chat_id: int,
    user_id: int,
    answers
):
    rows = []

    row = []

    for answer in answers:

        row.append(
            InlineKeyboardButton(
                text=str(answer),
                callback_data=f"captcha:{chat_id}:{user_id}:{answer}"
            )
        )

        if len(row) == 2:
            rows.append(row)
            row = []

    if row:
        rows.append(row)

    return InlineKeyboardMarkup(
        inline_keyboard=rows
    )


async def send_captcha(
    chat_id: int,
    user
):
    question, correct, answers = create_captcha()

    text = (
        f"🧩 <b>Проверка</b>\n\n"
        f"{mention_user(user.id, user.full_name)}, "
        f"решите пример:\n\n"
        f"<b>{question} = ?</b>\n\n"
        f"⚠️ Пока вы не пройдёте проверку, писать сообщения в чат нельзя.\n"
        f"Эта капча предназначена только для вас."
    )

    message = await bot.send_message(
        chat_id=chat_id,
        text=text,
        reply_markup=captcha_keyboard(
            chat_id,
            user.id,
            answers
        )
    )

    cursor.execute(
        """
        INSERT OR REPLACE INTO captchas
        (chat_id, user_id, message_id, question, correct_answer, created_at)
        VALUES (?, ?, ?, ?, ?, ?)
        """,
        (
            chat_id,
            user.id,
            message.message_id,
            question,
            str(correct),
            int(time.time())
        )
    )

    db.commit()


