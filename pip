@dp.callback_query(F.data.startswith("captcha:"))
async def captcha_callback(
    callback: CallbackQuery
):
    try:
        _, chat_id, user_id, answer = callback.data.split(":")

        chat_id = int(chat_id)
        user_id = int(user_id)
        answer = int(answer)

    except Exception:
        await callback.answer(
            "Ошибка капчи.",
            show_alert=True
        )
        return

    # Чужую капчу нажать нельзя.
    if callback.from_user.id != user_id:

        await callback.answer(
            "❌ Это не ваша капча.",
            show_alert=True
        )

        return

    row = cursor.execute(
        """
        SELECT *
        FROM captchas
        WHERE chat_id = ?
        AND user_id = ?
        """,
        (
            chat_id,
            user_id
        )
    ).fetchone()

    if not row:

        await callback.answer(
            "Эта капча уже завершена.",
            show_alert=True
        )

        return

    correct_answer = int(
        row["correct_answer"]
    )

    if answer != correct_answer:

        await callback.answer(
            "❌ Неверно. Попробуйте ещё раз.",
            show_alert=True
        )

        return

    # Удаляем капчу из БД.
    cursor.execute(
        """
        DELETE FROM captchas
        WHERE chat_id = ?
        AND user_id = ?
        """,
        (
            chat_id,
            user_id
        )
    )

    db.commit()

    # Снимаем ограничение.
    await unrestrict_user(
        chat_id,
        user_id
    )

    try:
        await callback.message.edit_text(
            "✅ <b>Проверка пройдена!</b>\n\n"
            f"{mention_user(callback.from_user.id, callback.from_user.full_name)}, "
            "теперь вы можете писать в чат."
        )

    except TelegramBadRequest:
        pass

    await callback.answer(
        "✅ Готово!"
    )

    # Если капч больше нет — удаляем приветствие.
    await delete_old_welcome_if_possible(
        chat_id
    )


