# =========================================================
# CAPTCHA
# =========================================================

@dp.callback_query(
    F.data.startswith("captcha:")
)
async def captcha_callback(
    callback: CallbackQuery
):

    try:

        _, user_id, selected = (
            callback.data.split(":")
        )

        user_id = int(user_id)
        selected = int(selected)

    except Exception:

        await callback.answer(
            "Ошибка капчи.",
            show_alert=True
        )

        return

    # Чужой пользователь
    if callback.from_user.id != user_id:

        await callback.answer(
            "❌ Эта капча не для тебя.",
            show_alert=True
        )

        return

    chat_id = callback.message.chat.id

    row = db.execute(
        """
        SELECT *
        FROM captchas
        WHERE chat_id = ?
        AND user_id = ?
        """,
        (
            chat_id,
            user_id
        )
    ).fetchone()

    if not row:

        await callback.answer(
            "Эта капча уже пройдена.",
            show_alert=True
        )

        return

    correct_answer = row["answer"]

    if selected != correct_answer:

        await callback.answer(
            "❌ Неверно. Попробуй ещё раз.",
            show_alert=True
        )

        return

    # Удаляем пользователя из капч
    db.execute(
        """
        DELETE FROM captchas
        WHERE chat_id = ?
        AND user_id = ?
        """,
        (
            chat_id,
            user_id
        )
    )

    db.commit()

    # Разрешаем писать
    await unrestrict_user(
        chat_id,
        user_id
    )

    # Если это была последняя капча —
    # удаляем общее сообщение
    if not captcha_exists(chat_id):

        await delete_all_welcomes(
            chat_id
        )

    else:

        # Если остались другие пользователи,
        # просто убираем кнопки конкретной капчи
        # полностью пересоздать сообщение безопаснее:
        try:

            rows = db.execute(
                """
                SELECT *
                FROM captchas
                WHERE chat_id = ?
                ORDER BY created_at
                """,
                (chat_id,)
            ).fetchall()

            if rows:

                text = (
                    "👋 <b>Добро пожаловать в чат Stardew Valley!</b>\n\n"
                )

                captcha_data = []

                for row2 in rows:

                    uid = row2["user_id"]

                    try:

                        member = await bot.get_chat_member(
                            chat_id,
                            uid
                        )

                        uname = member.user.full_name

                    except Exception:

                        uname = "Пользователь"

                    text += (
                        f"👤 {mention_user(uid, uname)}\n"
                    )

                    question = row2["question"]

                    text += (
                        f"🔐 Реши: <code>{question}</code>\n\n"
                    )

                    # Получаем варианты заново.
                    # Правильный ответ обязательно сохраняем.
                    answer = row2["answer"]

                    options = {answer}

                    while len(options) < 4:

                        value = answer + random.randint(-5, 5)

                        if value >= 0:
                            options.add(value)

                    options = list(options)
                    random.shuffle(options)

                    captcha_data.append(
                        (uid, options)
                    )

                text += (
                    "⚠️ Каждый участник может пройти "
                    "только свою капчу."
                )

                await callback.message.edit_text(
                    text,
                    parse_mode="HTML",
                    disable_web_page_preview=True,
                    reply_markup=build_captcha_keyboard(
                        captcha_data
                    )
                )

        except Exception as e:

            logger.error(
                f"Ошибка обновления капчи: {e}"
            )

    await callback.answer(
        "✅ Капча пройдена!"
    )


