welcome_queue = {}


async def process_welcome_queue(chat_id: int):
    await asyncio.sleep(1)

    users = welcome_queue.pop(chat_id, [])

    if not users:
        return

    # Не удаляем старое приветствие,
    # если есть незавершённая капча.
    if not has_active_captchas(chat_id):

        row = cursor.execute(
            """
            SELECT message_id
            FROM welcome_messages
            WHERE chat_id = ?
            """,
            (chat_id,)
        ).fetchone()

        if row:

            try:
                await bot.delete_message(
                    chat_id=chat_id,
                    message_id=row["message_id"]
                )
            except TelegramBadRequest:
                pass

    names = []

    for user in users:
        names.append(
            mention_user(
                user.id,
                user.full_name
            )
        )

    text = (
        "👋 <b>Добро пожаловать в чат Stardrew Valley!</b>\n\n"
        + "\n".join(names)
        + "\n\n"
        f"📖 <b>Правила</b> — {RULES_URL}"
    )

    message = await bot.send_message(
        chat_id=chat_id,
        text=text,
        disable_web_page_preview=True
    )

    cursor.execute(
        """
        INSERT OR REPLACE INTO welcome_messages
        (chat_id, message_id)
        VALUES (?, ?)
        """,
        (
            chat_id,
            message.message_id
        )
    )

    db.commit()


@dp.chat_join_request()
async def join_request_handler(
    request: ChatJoinRequest
):
    chat_id = request.chat.id
    user = request.from_user

    if not allowed_chat(chat_id):
        return

    try:
        # Сначала принимаем заявку.
        await request.approve()

        # После принятия сразу запрещаем писать.
        await restrict_user(
            chat_id,
            user.id
        )

        # Создаём капчу.
        await send_captcha(
            chat_id,
            user
        )

        # Добавляем пользователя в очередь приветствия.
        if chat_id not in welcome_queue:
            welcome_queue[chat_id] = []

            asyncio.create_task(
                process_welcome_queue(chat_id)
            )

        welcome_queue[chat_id].append(user)

        logger.info(
            "Принята заявка: %s (%s)",
            user.full_name,
            user.id
        )

    except Exception as e:
        logger.exception(
            "Ошибка при обработке заявки: %s",
            e
        )


