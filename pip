@dp.callback_query(
    F.data.startswith("game:delete:")
)
async def delete_game(
    callback: CallbackQuery
):

    try:

        message_id = int(
            callback.data.split(":")[2]
        )

    except Exception:

        await callback.answer(
            "Ошибка."
        )

        return

    game = games.get(
        message_id
    )

    if game:

        allowed = (
            callback.from_user.id == game.creator_id
            or await is_moderator(
                game.chat_id,
                callback.from_user.id
            )
        )

        if not allowed:

            await callback.answer(
                "❌ Удалить может создатель "
                "или модератор.",
                show_alert=True
            )

            return

        games.pop(
            message_id,
            None
        )

    else:

        if not await is_moderator(
            callback.message.chat.id,
            callback.from_user.id
        ):

            await callback.answer(
                "❌ Удалить может только модератор.",
                show_alert=True
            )

            return

    timer_task = game_timer_tasks.pop(
        message_id,
        None
    )

    if timer_task:
        timer_task.cancel()

    try:

        await callback.message.delete()

    except Exception:
        pass

    await callback.answer(
        "🗑 Игра удалена."
    )


