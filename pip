async def save_welcome(
    chat_id: int,
    message_id: int
):

    db.execute(
        """
        INSERT OR IGNORE INTO welcome_messages
        (chat_id, message_id)
        VALUES (?, ?)
        """,
        (
            chat_id,
            message_id
        )
    )

    db.commit()


async def delete_all_welcomes(
    chat_id: int
):

    rows = db.execute(
        """
        SELECT message_id
        FROM welcome_messages
        WHERE chat_id = ?
        """,
        (chat_id,)
    ).fetchall()

    for row in rows:

        try:
            await bot.delete_message(
                chat_id=chat_id,
                message_id=row["message_id"]
            )
        except Exception:
            pass

    db.execute(
        """
        DELETE FROM welcome_messages
        WHERE chat_id = ?
        """,
        (chat_id,)
    )

    db.commit()


async def build_current_captcha_message(
    chat_id: int
):

    rows = db.execute(
        """
        SELECT *
        FROM captchas
        WHERE chat_id = ?
        ORDER BY created_at ASC
        """,
        (chat_id,)
    ).fetchall()

    if not rows:
        return None, None

    text = (
        "👋 <b>Добро пожаловать в Stardew Valley!</b>\n\n"
        "🌻 Общаемся, помогаем новичкам и вместе играем.\n"
        "Ознакомьтесь с правилами и соблюдайте их.\n\n"
    )

    captcha_data = []

    for row in rows:

        user_id = row["user_id"]

        try:
            member = await bot.get_chat_member(
                chat_id,
                user_id
            )

            user = member.user

            user_name = get_username(user)
            full_name = user.full_name

        except Exception:

            user_name = "пользователь"
            full_name = "Пользователь"

        text += (
            f"👤 {mention_user(user_id, full_name)} "
            f"({html.escape(user_name)})\n"
        )

        text += (
            f"🧮 <code>{row['question']}</code> = ...\n"
            "Выбери ответ ниже.\n\n"
        )

        captcha_data.append(
            (
                user_id,
                generate_options(
                    row["answer"]
                )
            )
        )

    text += (
        "⚠️ Каждый участник может пройти "
        "только свою капчу."
    )

    return text, captcha_keyboard(
        captcha_data
    )


async def send_welcome_batch(
    chat_id: int
):

    await asyncio.sleep(
        WELCOME_BATCH_DELAY
    )

    users = welcome_queue.pop(
        chat_id,
        []
    )

    if not users:
        return

    # Если старых капч нет,
    # старое приветствие можно удалить.
    if not captcha_exists(chat_id):

        await delete_all_welcomes(
            chat_id
        )

    # Создаём капчи
    for user in users:

        question, answer, options = create_captcha()

        db.execute(
            """
            INSERT OR REPLACE INTO captchas
            (
                chat_id,
                user_id,
                message_id,
                question,
                answer,
                created_at
            )
            VALUES (?, ?, ?, ?, ?, ?)
            """,
            (
                chat_id,
                user.id,
                0,
                question,
                answer,
                int(time.time())
            )
        )

    db.commit()

    text, keyboard = await build_current_captcha_message(
        chat_id
    )

    if not text:
        return

    try:

        message = await bot.send_message(
            chat_id=chat_id,
            text=text,
            parse_mode="HTML",
            disable_web_page_preview=True,
            reply_markup=keyboard
        )

    except Exception as e:

        logger.exception(
            f"Ошибка отправки приветствия: {e}"
        )

        db.execute(
            """
            DELETE FROM captchas
            WHERE chat_id = ?
            """,
            (chat_id,)
        )

        db.commit()

        return

    # Сохраняем ID сообщения капчи
    db.execute(
        """
        UPDATE captchas
        SET message_id = ?
        WHERE chat_id = ?
        """,
        (
            message.message_id,
            chat_id
        )
    )

    db.commit()

    await save_welcome(
        chat_id,
        message.message_id
    )


async def queue_welcome(
    chat_id: int,
    user
):

    if chat_id not in welcome_queue:
        welcome_queue[chat_id] = []

    welcome_queue[chat_id].append(
        user
    )

    old_task = welcome_tasks.get(
        chat_id
    )

    if old_task and not old_task.done():
        old_task.cancel()

    welcome_tasks[chat_id] = asyncio.create_task(
        send_welcome_batch(chat_id)
    )


