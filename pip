def game_keyboard(
    board,
    game_message_id
):

    buttons = []

    for index in range(9):

        value = board[index]

        if value == "":
            text = "·"
        else:
            text = value

        buttons.append(
            InlineKeyboardButton(
                text=text,
                callback_data=f"ttt:{game_message_id}:{index}"
            )
        )

    rows = [
        buttons[0:3],
        buttons[3:6],
        buttons[6:9]
    ]

    rows.append(
        [
            InlineKeyboardButton(
                text="🔴 Удалить",
                callback_data=f"ttt_delete:{game_message_id}"
            )
        ]
    )

    return InlineKeyboardMarkup(
        inline_keyboard=rows
    )


def check_winner(board):

    combinations = [
        (0, 1, 2),
        (3, 4, 5),
        (6, 7, 8),

        (0, 3, 6),
        (1, 4, 7),
        (2, 5, 8),

        (0, 4, 8),
        (2, 4, 6)
    ]

    for a, b, c in combinations:

        if (
            board[a]
            and board[a] == board[b]
            and board[a] == board[c]
        ):
            return board[a]

    if all(board):
        return "draw"

    return None


def render_board(board):

    symbols = []

    for value in board:

        if value == "❌":
            symbols.append("❌")

        elif value == "⭕":
            symbols.append("⭕")

        else:
            symbols.append("▫️")

    return (
        f"{symbols[0]} {symbols[1]} {symbols[2]}\n"
        f"{symbols[3]} {symbols[4]} {symbols[5]}\n"
        f"{symbols[6]} {symbols[7]} {symbols[8]}"
    )


