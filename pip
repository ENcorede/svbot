def is_bot_admin(user_id: int) -> bool:
    return user_id in BOT_ADMINS


def group_exists(chat_id: int) -> bool:
    return chat_id in GROUPS


def get_setting(chat_id, name, default=0):
    row = db.execute(
        f"SELECT {name} FROM settings WHERE chat_id = ?",
        (chat_id,)
    ).fetchone()

    if not row:
        db.execute(
            """
            INSERT OR IGNORE INTO settings
            (chat_id, readonly, captcha_enabled)
            VALUES (?, 0, 1)
            """,
            (chat_id,)
        )
        db.commit()
        return default

    return row[name]


def set_setting(chat_id, name, value):
    db.execute(
        """
        INSERT OR IGNORE INTO settings
        (chat_id, readonly, captcha_enabled)
        VALUES (?, 0, 1)
        """,
        (chat_id,)
    )

    db.execute(
        f"""
        UPDATE settings
        SET {name} = ?
        WHERE chat_id = ?
        """,
        (value, chat_id)
    )

    db.commit()


def get_stats(chat_id):
    row = db.execute(
        """
        SELECT *
        FROM statistics
        WHERE chat_id = ?
        """,
        (chat_id,)
    ).fetchone()

    if not row:
        db.execute(
            """
            INSERT OR IGNORE INTO statistics
            (chat_id)
            VALUES (?)
            """,
            (chat_id,)
        )
        db.commit()

        return {
            "joins": 0,
            "messages_deleted": 0,
            "mutes": 0,
            "bans": 0,
            "kicks": 0,
        }

    return dict(row)


def increment_stat(chat_id, field):
    db.execute(
        """
        INSERT OR IGNORE INTO statistics
        (chat_id)
        VALUES (?)
        """,
        (chat_id,)
    )

    db.execute(
        f"""
        UPDATE statistics
        SET {field} = {field} + 1
        WHERE chat_id = ?
        """,
        (chat_id,)
    )

    db.commit()


