@dp.callback_query(
    F.data.startswith("captcha_info:")
)
async def captcha_info(
    callback: CallbackQuery
):

    try:

        user_id = int(
            callback.data.split(":")[1]
        )

    except Exception:

        await callback.answer(
            "Ошибка.",
            show_alert=True
        )

        return

    if callback.from_user.id != user_id:

        await callback.answer(
            "❌ Эта капча предназначена другому пользователю.",
            show_alert=True
        )

        return

    await callback.answer(
        "Это твоя капча. Выбери правильный ответ.",
        show_alert=True
    )


@dp.callback_query(
    F.data.startswith("captcha:")
)
async def captcha_callback(
    callback: CallbackQuery
):

    try:

        parts = callback.data.split(":")

        user_id = int(parts[1])
        selected = int(parts[2])

    except Exception:

        await callback.answer(
            "Ошибка.",
            show_alert=True
        )

        return

    # Чужая капча
    if callback.from_user.id != user_id:

        await callback.answer(
            "❌ Эта капча не для тебя.",
            show_alert=True
        )

        return

    chat_id = callback.message.chat.id

    row = db.execute(
        """
        SELECT *
        FROM captchas
        WHERE chat_id = ?
        AND user_id = ?
        """,
        (
            chat_id,
            user_id
        )
    ).fetchone()

    if not row:

        await callback.answer(
            "Капча уже пройдена.",
            show_alert=True
        )

        return

    if selected != row["answer"]:

        await callback.answer(
            "❌ Неверно. Попробуй ещё раз.",
            show_alert=True
        )

        return

    # Удаляем капчу
    db.execute(
        """
        DELETE FROM captchas
        WHERE chat_id = ?
        AND user_id = ?
        """,
        (
            chat_id,
            user_id
        )
    )

    db.commit()

    # Разрешаем писать
    try:

        await bot.restrict_chat_member(
            chat_id=chat_id,
            user_id=user_id,
            permissions=FULL_PERMISSIONS
        )

    except Exception as e:

        logger.error(
            f"Ошибка снятия мута после капчи: {e}"
        )

    # Если капч больше нет,
    # удаляем общее сообщение.
    if not captcha_exists(chat_id):

        await delete_all_welcomes(
            chat_id
        )

    else:

        # Оставшиеся капчи обновляем
        try:

            text, keyboard = (
                await build_current_captcha_message(
                    chat_id
                )
            )

            if text:

                await callback.message.edit_text(
                    text=text,
                    parse_mode="HTML",
                    disable_web_page_preview=True,
                    reply_markup=keyboard
                )

        except Exception as e:

            logger.error(
                f"Ошибка обновления капчи: {e}"
            )

    await callback.answer(
        "✅ Капча пройдена!"
    )


