@dp.message(
    F.chat.type == "private"
)
async def private_messages(
    message: Message
):

    if not is_bot_admin(
        message.from_user.id
    ):
        return

    state = admin_states.get(
        message.from_user.id
    )

    if not state:
        return

    if state.get("action") != "blacklist_add":
        return

    chat_id = state["chat_id"]

    words = [
        word.strip().lower()
        for word in (
            message.text or ""
        ).splitlines()
        if word.strip()
    ]

    words = list(
        dict.fromkeys(words)
    )

    for word in words:

        db.execute(
            """
            INSERT OR IGNORE INTO blacklist
            (chat_id, word)
            VALUES (?, ?)
            """,
            (
                chat_id,
                word
            )
        )

    db.commit()

    await safe_delete(message)

    state_message_id = (
        state["message_id"]
    )

    text = await blacklist_text(
        chat_id
    )

    keyboard = blacklist_menu_keyboard(
        chat_id
    )

    try:

        await bot.edit_message_text(
            chat_id=state["chat_id"],
            message_id=state_message_id,
            text=(
                f"🚫 <b>Чёрный список — "
                f"{escape_text(group_title(chat_id))}</b>\n\n"
                f"{text}\n\n"
                "Список обновлён."
            ),
            parse_mode="HTML",
            reply_markup=add_delete_button(
                keyboard
            )
        )

    except Exception as e:

        logger.error(
            f"Blacklist edit error: {e}"
        )

    admin_states.pop(
        message.from_user.id,
        None
    )


