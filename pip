):
    if not is_bot_admin(
        callback.from_user.id
    ):
        return

    parts = callback.data.split(
        ":",
        2,
    )

    if len(parts) != 3:
        return

    try:
        chat_id = int(parts[1])
        rowid = int(parts[2])
    except Exception:
        return

    db.execute(
        """
        DELETE FROM blacklist
        WHERE chat_id = ?
        AND rowid = ?
        """,
        (
            chat_id,
            rowid,
        ),
    )

    db.commit()

    await callback.answer(
        "Слово удалено."
    )

    await show_blacklist(
        callback,
        chat_id,
    )


