            )
        except Exception:
            pass

    db.execute(
        """
        DELETE FROM welcome_messages
        WHERE chat_id = ?
        """,
        (chat_id,)
    )

    db.commit()


async def send_welcome_batch(
    chat_id
):

    await asyncio.sleep(1.5)

    users = welcome_queue.pop(
        chat_id,
        []
    )

    if not users:
        return

    # Удаляем дубликаты пользователей
    unique_users = {}

    for user in users:
        unique_users[user.id] = user

    for user in unique_users.values():

        question, answer, options = create_captcha()

        db.execute(
            """
            INSERT OR REPLACE INTO captchas
            (
                chat_id,
                user_id,
                question,
                answer,
                options,
                created_at
            )
            VALUES (?, ?, ?, ?, ?, ?)
            """,
            (
                chat_id,
                user.id,
                question,
                answer,
                options_to_text(options),
                int(time.time())
            )
        )

    db.commit()

    text, keyboard = await build_captcha_message(
        chat_id
    )

    if not text:
        return

    try:

        message = await send_bot_message(
            chat_id,
            text,
            keyboard
        )

    except Exception as e:

        logger.exception(
            f"CAPTCHA error: {e}"
        )

        return

    db.execute(
        """
        INSERT OR IGNORE INTO welcome_messages
        (chat_id, message_id)
        VALUES (?, ?)
        """,
        (
            chat_id,
            message.message_id
        )
    )

    db.commit()


async def queue_welcome(
    chat_id,
    user
):

    if chat_id not in welcome_queue:
        welcome_queue[chat_id] = []

    welcome_queue[chat_id].append(user)

    old_task = welcome_tasks.get(
        chat_id
    )

    if old_task and not old_task.done():
        old_task.cancel()

    welcome_tasks[chat_id] = asyncio.create_task(
        send_welcome_batch(chat_id)
    )


