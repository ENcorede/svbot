def create_captcha():

    a = random.randint(1, 9)
    b = random.randint(1, 9)

    if random.choice([True, False]):

        question = f"{a} + {b}"
        answer = a + b

    else:

        if b > a:
            a, b = b, a

        question = f"{a} - {b}"
        answer = a - b

    options = {answer}

    while len(options) < 4:

        value = answer + random.randint(-5, 5)

        if value >= 0:
            options.add(value)

    options = list(options)

    random.shuffle(options)

    return question, answer, options


def options_to_text(options):
    return ",".join(
        str(x)
        for x in options
    )


def text_to_options(text):
    return [
        int(x)
        for x in text.split(",")
        if x
    ]


