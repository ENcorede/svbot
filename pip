def is_bot_admin(user_id: int) -> bool:
    return user_id in BOT_ADMINS


def is_managed_group(chat_id: int) -> bool:
    return chat_id in GROUPS


def group_title(chat_id: int) -> str:
    info = GROUPS.get(chat_id)

    if not info:
        return "Группа"

    return f"{info['emoji']} {info['name']}"


def escape_text(text: str) -> str:
    return html.escape(text or "")


def mention(user) -> str:
    name = escape_text(
        user.full_name or "Пользователь"
    )

    return (
        f'<a href="tg://user?id={user.id}">'
        f'{name}'
        f'</a>'
    )


def display_user(user) -> str:
    if user.username:
        return f"@{escape_text(user.username)}"

    return mention(user)


async def safe_delete(message):
    try:
        await message.delete()
    except Exception:
        pass


async def is_group_admin(chat_id: int, user_id: int) -> bool:
    try:
        member = await bot.get_chat_member(
            chat_id,
            user_id
        )

        return member.status in {
            ChatMemberStatus.ADMINISTRATOR,
            ChatMemberStatus.CREATOR,
        }

    except Exception:
        return False


def ensure_chat_settings(chat_id: int):

    db.execute(
        """
        INSERT OR IGNORE INTO settings
        (chat_id, readonly, captcha_enabled)
        VALUES (?, 0, 1)
        """,
        (chat_id,)
    )

    db.execute(
        """
        INSERT OR IGNORE INTO statistics
        (chat_id, joins, messages_deleted, mutes, bans, kicks)
        VALUES (?, 0, 0, 0, 0, 0)
        """,
        (chat_id,)
    )

    db.commit()


def get_setting(
    chat_id: int,
    setting: str,
    default=0
):

    ensure_chat_settings(chat_id)

    row = db.execute(
        f"""
        SELECT {setting}
        FROM settings
        WHERE chat_id = ?
        """,
        (chat_id,)
    ).fetchone()

    if not row:
        return default

    return row[setting]


def set_setting(
    chat_id: int,
    setting: str,
    value
):

    ensure_chat_settings(chat_id)

    db.execute(
        f"""
        UPDATE settings
        SET {setting} = ?
        WHERE chat_id = ?
        """,
        (
            value,
            chat_id
        )
    )

    db.commit()


def increment_stat(
    chat_id: int,
    field: str
):

    ensure_chat_settings(chat_id)

    db.execute(
        f"""
        UPDATE statistics
        SET {field} = {field} + 1
        WHERE chat_id = ?
        """,
        (chat_id,)
    )

    db.commit()


def get_stats(chat_id):

    ensure_chat_settings(chat_id)

    row = db.execute(
        """
        SELECT *
        FROM statistics
        WHERE chat_id = ?
        """,
        (chat_id,)
    ).fetchone()

    return dict(row)


