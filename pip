@dp.callback_query(
    F.data.startswith("captcha:")
)
async def captcha_callback(
    callback: CallbackQuery
):

    try:
        _, user_id_text, selected_text = (
            callback.data.split(":")
        )

        user_id = int(user_id_text)
        selected = int(selected_text)

    except Exception:
        return

    if callback.from_user.id != user_id:

        await callback.answer(
            "❌ Это не твоя капча.",
            show_alert=True
        )
        return

    chat_id = callback.message.chat.id

    row = db.execute(
        """
        SELECT *
        FROM captchas
        WHERE chat_id = ?
        AND user_id = ?
        """,
        (
            chat_id,
            user_id
        )
    ).fetchone()

    if not row:
        await callback.answer(
            "Капча уже пройдена."
        )
        return

    if selected != row["answer"]:

        await callback.answer(
            "❌ Неверно.",
            show_alert=True
        )
        return

    db.execute(
        """
        DELETE FROM captchas
        WHERE chat_id = ?
        AND user_id = ?
        """,
        (
            chat_id,
            user_id
        )
    )

    db.commit()

    try:

        await bot.restrict_chat_member(
            chat_id=chat_id,
            user_id=user_id,
            permissions=ChatPermissions(
                can_send_messages=True,
                can_send_audios=True,
                can_send_documents=True,
                can_send_photos=True,
                can_send_videos=True,
                can_send_video_notes=True,
                can_send_voice_notes=True,
                can_send_polls=True,
                can_send_other_messages=True,
                can_add_web_page_previews=True,
            )
        )

    except Exception as e:
        logger.error(
            f"Ошибка снятия CAPTCHA-ограничения: {e}"
        )

    count = db.execute(
        """
        SELECT COUNT(*) AS count
        FROM captchas
        WHERE chat_id = ?
        """,
        (chat_id,)
    ).fetchone()["count"]

    if count == 0:

        await delete_welcome_messages(
            chat_id
        )

    else:

        text, keyboard = await build_captcha_message(
            chat_id
        )

        try:

            await callback.message.edit_text(
                text=text,
                parse_mode="HTML",
                disable_web_page_preview=True,
                reply_markup=with_delete_button(
                    keyboard
                )
            )

        except Exception:
            pass

    await callback.answer(
        "✅ Капча пройдена!"
    )


