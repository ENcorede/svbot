def parse_duration(value):

    value = value.lower().strip()

    match = re.fullmatch(
        r"(\d+)\s*"
        r"(с|сек|секунд[аы]?|"
        r"м|мин|минут[аы]?|"
        r"ч|час|часа|"
        r"д|дн|день|дня|дней)",
        value
    )

    if not match:
        return None

    number = int(
        match.group(1)
    )

    unit = match.group(2)

    if unit in {
        "с",
        "сек",
        "секунда",
        "секунды",
        "секунд"
    }:
        return timedelta(
            seconds=number
        )

    if unit in {
        "м",
        "мин",
        "минута",
        "минуты"
    }:
        return timedelta(
            minutes=number
        )

    if unit in {
        "ч",
        "час",
        "часа"
    }:
        return timedelta(
            hours=number
        )

    return timedelta(
        days=number
    )


def parse_mute(text):

    parts = text.split()

    if len(parts) < 3:
        return None

    duration = parse_duration(
        parts[-1]
    )

    if duration:

        reason = " ".join(
            parts[1:-1]
        ).strip()

        if not reason:
            reason = "нарушение правил группы"

        return reason, duration

    match = re.search(
        r"(\d{2}\.\d{2}\.\d{4})\s+"
        r"(\d{2}:\d{2})\s*$",
        text
    )

    if not match:
        return None

    reason = text[
        4:match.start()
    ].strip()

    if not reason:
        reason = "нарушение правил группы"

    try:

        target = datetime.strptime(
            f"{match.group(1)} {match.group(2)}",
            "%d.%m.%Y %H:%M"
        )

        now = datetime.now()

        duration = target - now

        if duration.total_seconds() <= 0:
            return None

        return reason, duration

    except Exception:
        return None


def format_duration(seconds):

    seconds = int(seconds)

    days = seconds // 86400
    hours = seconds // 3600
    minutes = seconds // 60

    if days > 0:

        return (
            f"{days} дн. "
            f"({hours} ч / "
            f"{seconds:,} сек)"
        ).replace(",", " ")

    if hours > 0:

        return (
            f"{hours} ч "
            f"({seconds:,} сек)"
        ).replace(",", " ")

    if minutes > 0:

        return (
            f"{minutes} мин "
            f"({seconds:,} сек)"
        ).replace(",", " ")

    return f"{seconds} сек"


@dp.message(
    Command("mut")
)
async def mute_command(
    message: Message
):

    chat_id = message.chat.id

    if not is_managed_group(chat_id):
        await safe_delete(message)
        return

    if not await is_group_admin(
        chat_id,
        message.from_user.id
    ):
        await safe_delete(message)
        return

    if not message.reply_to_message:
        await safe_delete(message)
        return

    target = message.reply_to_message.from_user

    if not target:
        await safe_delete(message)
        return

    if await is_group_admin(
        chat_id,
        target.id
    ):
        await safe_delete(message)
        return

    parsed = parse_mute(
        message.text or ""
    )

    if not parsed:

        await safe_delete(message)

        await send_bot_message(
            chat_id,
            "⚠️ <b>Неверный формат.</b>\n\n"
            "<code>/mut причина 1м</code>\n"
            "<code>/mut причина 30м</code>\n"
            "<code>/mut причина 2ч</code>\n"
            "<code>/mut причина 3д</code>\n\n"
            "Или:\n"
            "<code>/mut причина 07.10.2026 09:00</code>"
        )

        return

    reason, duration = parsed

    seconds = max(
        1,
        int(duration.total_seconds())
    )

    # ВАЖНО:
    # Считаем от текущего UTC времени.
    # Это предотвращает старую проблему,
    # когда 1 минута превращалась в часы.
    until = datetime.now(
        timezone.utc
    ) + timedelta(
        seconds=seconds
    )

    try:

        await bot.restrict_chat_member(
            chat_id=chat_id,
            user_id=target.id,
            permissions=ChatPermissions(
                can_send_messages=False,
                can_send_audios=False,
                can_send_documents=False,
                can_send_photos=False,
                can_send_videos=False,
                can_send_video_notes=False,
                can_send_voice_notes=False,
                can_send_polls=False,
                can_send_other_messages=False,
                can_add_web_page_previews=False,
            ),
            until_date=until
        )

    except Exception as e:

        logger.exception(
            f"Mute error: {e}"
        )

        await safe_delete(message)

        await send_bot_message(
            chat_id,
            "❌ Не удалось выдать мут.\n"
            "Проверь права бота."
        )

        return

    increment_stat(
        chat_id,
        "mutes"
    )

    await safe_delete(message)

    await send_bot_message(
        chat_id,
        "🚫 <b>Пользователь получает ограничение</b>\n\n"
        f"👤 {display_user(target)}\n"
        f"⏳ <b>Срок:</b> {format_duration(seconds)}\n"
        f"📌 <b>Причина:</b> {escape_text(reason)}\n"
        f'📜 <b>Правила:</b> '
        f'<a href="{RULES_URL}">открыть</a>'
    )


