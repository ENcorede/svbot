@dp.callback_query(F.data.startswith("game:join:"))
async def game_join(callback: CallbackQuery):

    try:
        message_id = int(
            callback.data.split(":")[2]
        )
    except Exception:
        await callback.answer("Ошибка.")
        return

    game = games.get(message_id)

    if not game:
        await callback.answer(
            "Игра уже закончилась.",
            show_alert=True
        )
        return

    if game.started:
        await callback.answer(
            "Игра уже началась.",
            show_alert=True
        )
        return

    if callback.from_user.id == game.creator_id:
        await callback.answer(
            "Ты уже создал эту игру.",
            show_alert=True
        )
        return

    game.player2_id = callback.from_user.id
    game.player2_name = callback.from_user.full_name
    game.started = True
    game.turn = 1

    await callback.message.edit_text(
        "🎮 *КРЕСТИКИ-НОЛИКИ*\n\n"
        f"❌ {mention_user(game.creator_id, game.creator_name)}\n"
        f"⭕ {mention_user(game.player2_id, game.player2_name)}\n\n"
        "Ход: ❌",
        parse_mode="Markdown",
        reply_markup=game_keyboard(game)
    )

    await callback.answer(
        "Ты присоединился к игре!"
    )


