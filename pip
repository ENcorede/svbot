async def save_welcome(
    chat_id: int,
    message_id: int
):

    db.execute(
        """
        INSERT OR IGNORE INTO welcome_messages
        (chat_id, message_id)
        VALUES (?, ?)
        """,
        (
            chat_id,
            message_id
        )
    )

    db.commit()


async def delete_all_welcomes(
    chat_id: int
):

    rows = db.execute(
        """
        SELECT message_id
        FROM welcome_messages
        WHERE chat_id = ?
        """,
        (chat_id,)
    ).fetchall()

    for row in rows:

        try:

            await bot.delete_message(
                chat_id=chat_id,
                message_id=row["message_id"]
            )

        except Exception:
            pass

    db.execute(
        """
        DELETE FROM welcome_messages
        WHERE chat_id = ?
        """,
        (chat_id,)
    )

    db.commit()


# =========================================================
# ОБЩЕЕ СООБЩЕНИЕ: ПРИВЕТСТВИЕ + КАПЧА
# =========================================================

async def send_welcome_batch(
    chat_id: int
):

    await asyncio.sleep(
        WELCOME_BATCH_DELAY
    )

    users = welcome_queue.pop(
        chat_id,
        []
    )

    if not users:
        return

    # Если старых активных капч нет,
    # старые приветствия удаляем.
    if not captcha_exists(chat_id):

        await delete_all_welcomes(
            chat_id
        )

    text = (
        "👋 <b>Добро пожаловать в чат Stardew Valley!</b>\n\n"
    )

    captcha_data = []

    for index, user in enumerate(users):

        if index > 0:
            text += "\n"

        text += (
            f"👤 {mention_user(user.id, user.full_name)}\n"
            "📖 <a href=\"https://t.me/stardewrus_chat/1255258\">Правила</a>\n"
        )

        question, answer, options = create_captcha()

        db.execute(
            """
            INSERT OR REPLACE INTO captchas
            (
                chat_id,
                user_id,
                message_id,
                question,
                answer,
                created_at
            )
            VALUES (?, ?, ?, ?, ?, ?)
            """,
            (
                chat_id,
                user.id,
                0,
                question,
                answer,
                int(time.time())
            )
        )

        captcha_data.append(
            (
                user.id,
                question,
                options
            )
        )

    text += "\n<b>🛡 ПРОВЕРКА</b>\n\n"

    for index, item in enumerate(captcha_data):

        user_id, question, options = item

        user = next(
            (
                u for u in users
                if u.id == user_id
            ),
            None
        )

        if not user:
            continue

        text += (
            f"🔐 {mention_user(user.id, user.full_name)}\n"
            f"Реши: <code>{question}</code>\n"
            "Нажми правильный ответ ниже.\n\n"
        )

    text += (
        "⚠️ Каждый участник может пройти "
        "только свою капчу."
    )

    # Временный ID сообщения 0 уже находится в БД.
    # Сначала отправляем сообщение.
    try:

        message = await bot.send_message(
            chat_id=chat_id,
            text=text,
            parse_mode="HTML",
            disable_web_page_preview=True,
            reply_markup=build_captcha_keyboard(
                [
                    (user_id, options)
                    for user_id, question, options
                    in captcha_data
                ]
            )
        )

    except Exception as e:

        logger.exception(
            f"Ошибка отправки welcome: {e}"
        )

        # Если сообщение не отправилось,
        # удаляем созданные капчи.
        db.execute(
            """
            DELETE FROM captchas
            WHERE chat_id = ?
            """,
            (chat_id,)
        )

        db.commit()

        return

    # Теперь сохраняем настоящий message_id
    db.execute(
        """
        UPDATE captchas
        SET message_id = ?
        WHERE chat_id = ?
        """,
        (
            message.message_id,
            chat_id
        )
    )

    db.commit()

    await save_welcome(
        chat_id,
        message.message_id
    )


async def queue_welcome(
    chat_id: int,
    user
):

    if chat_id not in welcome_queue:
        welcome_queue[chat_id] = []

    welcome_queue[chat_id].append(
        user
    )

    old_task = welcome_tasks.get(
        chat_id
    )

    if old_task and not old_task.done():

        old_task.cancel()

    welcome_tasks[chat_id] = asyncio.create_task(
        send_welcome_batch(chat_id)
    )


