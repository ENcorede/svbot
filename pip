@dp.callback_query(F.data.startswith("captcha:"))
async def captcha_callback(callback: CallbackQuery):

    try:
        _, target_user_id, selected = callback.data.split(":")
        target_user_id = int(target_user_id)
        selected = int(selected)

    except Exception:
        await callback.answer(
            "Ошибка капчи.",
            show_alert=True
        )
        return

    # Чужой пользователь
    if callback.from_user.id != target_user_id:
        await callback.answer(
            "❌ Эта капча не для тебя.",
            show_alert=True
        )
        return

    chat_id = callback.message.chat.id

    row = db.execute(
        """
        SELECT *
        FROM captchas
        WHERE chat_id = ?
        AND user_id = ?
        """,
        (chat_id, target_user_id)
    ).fetchone()

    if not row:
        await callback.answer(
            "Эта капча уже пройдена.",
            show_alert=True
        )
        return

    correct_answer = row["answer"]

    if selected != correct_answer:

        await callback.answer(
            "❌ Неверно. Попробуй ещё раз.",
            show_alert=True
        )

        return

    # Удаляем капчу из БД
    db.execute(
        """
        DELETE FROM captchas
        WHERE chat_id = ?
        AND user_id = ?
        """,
        (
            chat_id,
            target_user_id
        )
    )

    db.commit()

    # Возвращаем возможность писать
    await unrestrict_user(
        chat_id,
        target_user_id
    )

    try:
        await callback.message.edit_text(
            "✅ *Проверка пройдена!*\n\n"
            "Теперь ты можешь писать сообщения в чат.",
            parse_mode="Markdown"
        )

        await asyncio.sleep(2)

        await callback.message.delete()

    except Exception:
        pass

    # Если больше нет капч — удаляем приветствия
    if not captcha_exists(chat_id):
        await delete_all_welcomes(chat_id)

    await callback.answer(
        "✅ Проверка пройдена!"
    )


