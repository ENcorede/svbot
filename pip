@dp.message(
    F.chat.type == "private"
)
async def admin_private_input(
    message: Message
):

    if not is_bot_admin(
        message.from_user.id
    ):
        return

    state = admin_states.get(
        message.from_user.id
    )

    if not state:
        return

    if state.get("screen") != "blacklist_add":
        return

    chat_id = state["chat_id"]
    message_id = state["message_id"]

    words = [
        x.strip().lower()
        for x in (message.text or "").splitlines()
        if x.strip()
    ]

    words = list(
        dict.fromkeys(words)
    )

    if words:

        for word in words:

            db.execute(
                """
                INSERT OR IGNORE INTO blacklist
                (chat_id, word)
                VALUES (?, ?)
                """,
                (
                    chat_id,
                    word
                )
            )

        db.commit()

    # Удаляем ввод админа
    await safe_delete(message)

    rows = db.execute(
        """
        SELECT word
        FROM blacklist
        WHERE chat_id = ?
        ORDER BY word
        """,
        (chat_id,)
    ).fetchall()

    if rows:
        words_text = "\n".join(
            f"• <code>{html.escape(r['word'])}</code>"
            for r in rows
        )
    else:
        words_text = "Список пуст."

    keyboard = InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(
                    text="＋ Добавить ещё",
                    callback_data=f"blackadd:{chat_id}"
                )
            ],
            [
                InlineKeyboardButton(
                    text="− Удалить",
                    callback_data=f"blackdel:{chat_id}"
                )
            ],
            [
                InlineKeyboardButton(
                    text="‹ Назад",
                    callback_data=f"adminselect:group:{chat_id}"
                )
            ]
        ]
    )

    try:

        await bot.edit_message_text(
            chat_id=state["chat_id"],
            message_id=message_id,
            text=(
                "🚫 <b>Чёрный список</b>\n\n"
                f"{words_text}\n\n"
                "Добавленные слова автоматически удаляются "
                "из сообщений участников."
            ),
            parse_mode="HTML",
            reply_markup=with_delete_button(
                keyboard
            )
        )

    except Exception as e:

        logger.error(
            f"Ошибка обновления ЧС: {e}"
        )

    admin_states.pop(
        message.from_user.id,
        None
    )


