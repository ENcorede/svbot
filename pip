@dp.message(
    F.chat.type == "private"
)
async def private_messages(
    message: Message
):

    if not is_bot_admin(
        message.from_user.id
    ):
        return

    state = admin_states.get(
        message.from_user.id
    )

    if not state:
        return

    if state.get("action") != "blacklist_add":
        return

    group_id = state.get(
        "group_id"
    )

    private_chat_id = state.get(
        "private_chat_id"
    )

    panel_message_id = state.get(
        "message_id"
    )

    if group_id not in GROUPS:
        return

    # Только текст
    raw_text = message.text or ""

    words = []

    for line in raw_text.splitlines():

        word = normalize_blacklist_word(
            line
        )

        if word:
            words.append(word)

    # Убираем дубли
    words = list(
        dict.fromkeys(words)
    )

    added = 0

    for word in words:

        cursor = db.execute(
            """
            INSERT OR IGNORE INTO blacklist
            (chat_id, word)
            VALUES (?, ?)
            """,
            (
                group_id,
                word
            )
        )

        if cursor.rowcount > 0:
            added += 1

    db.commit()

    await safe_delete(message)

    current_words = get_blacklist_words(
        group_id
    )

    text = (
        f"🚫 <b>Чёрный список</b>\n"
        f"{escape_text(group_title(group_id))}\n\n"
        f"Добавлено новых: <b>{added}</b>\n"
        f"Всего слов: <b>{len(current_words)}</b>\n\n"
        f"{blacklist_text(group_id)}"
    )

    try:

        # ИСПРАВЛЕНО:
        # редактируем сообщение в ЛИЧНОМ чате админа,
        # а не в группе.
        await bot.edit_message_text(
            chat_id=private_chat_id,
            message_id=panel_message_id,
            text=text,
            parse_mode="HTML",
            reply_markup=add_delete_button(
                blacklist_menu_keyboard(group_id)
            )
        )

    except Exception as e:

        logger.error(
            f"Blacklist panel edit error: {e}"
        )

    admin_states[
        message.from_user.id
    ] = {
        "private_chat_id": private_chat_id,
        "message_id": panel_message_id,
        "group_id": group_id,
    }


