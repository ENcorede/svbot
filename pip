DROP_SEASONS = [
    "🌱 Весна",
    "☀️ Лето",
    "🍂 Осень",
    "❄️ Зима"
]

DROP_LOCATIONS = [
    "🏡 Ферма",
    "🌲 Лес",
    "⛏ Шахта",
    "🏖 Пляж",
    "🏘 Пеликан Таун",
    "🗻 Горы"
]

DROP_ITEMS = [
    "🥔 Картошка",
    "🍓 Клубника",
    "🫐 Черника",
    "🍄 Лисичка",
    "💎 Алмаз",
    "🪨 Камень",
    "🌾 Пшеница",
    "🐟 Рыба",
    "🥚 Яйцо"
]

DROP_WEATHER = [
    "☀️ Солнечно",
    "🌧 Дождь",
    "🌩 Гроза",
    "❄️ Снег",
    "🌬 Ветрено"
]


def generate_drop():

    season = random.choice(DROP_SEASONS)
    location = random.choice(DROP_LOCATIONS)
    item = random.choice(DROP_ITEMS)
    weather = random.choice(DROP_WEATHER)

    luck = random.randint(1, 100)

    return (
        "💧 *КАПЛЯ STARDEW*\n\n"
        f"{season}\n"
        f"{weather}\n"
        f"{location}\n\n"
        f"🎁 Находка: *{item}*\n"
        f"🍀 Удача: *{luck}%*\n\n"
        "Нажми кнопку, чтобы получить новую комбинацию."
    )


@dp.message(Command("drop"))
async def drop_command(message: Message):

    if message.chat.id != ALLOWED_CHAT_ID:
        return

    await message.answer(
        generate_drop(),
        parse_mode="Markdown",
        reply_markup=drop_keyboard()
    )


@dp.callback_query(F.data == "drop:new")
async def new_drop(callback: CallbackQuery):

    if callback.message.chat.id != ALLOWED_CHAT_ID:
        await callback.answer()
        return

    await callback.message.edit_text(
        generate_drop(),
        parse_mode="Markdown",
        reply_markup=drop_keyboard()
    )

    await callback.answer(
        "💧 Новая комбинация!"
    )


