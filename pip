async def delete_old_welcome_if_possible(chat_id: int):
    """
    Если незавершённых капч нет — удаляем старое приветствие.
    Если капча есть — старое сообщение не трогаем.
    """

    if has_active_captchas(chat_id):
        return

    row = cursor.execute(
        """
        SELECT message_id
        FROM welcome_messages
        WHERE chat_id = ?
        """,
        (chat_id,)
    ).fetchone()

    if not row:
        return

    message_id = row["message_id"]

    try:
        await bot.delete_message(
            chat_id=chat_id,
            message_id=message_id
        )
    except TelegramBadRequest:
        pass

    cursor.execute(
        "DELETE FROM welcome_messages WHERE chat_id = ?",
        (chat_id,)
    )

    db.commit()


