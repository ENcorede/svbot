@dp.chat_join_request()
async def join_request_handler(
    request: ChatJoinRequest
):

    chat_id = request.chat.id

    if not is_managed_group(chat_id):
        return

    user_id = request.from_user.id

    try:

        await request.approve()

        increment_stat(
            chat_id,
            "joins"
        )

        captcha_enabled = get_setting(
            chat_id,
            "captcha_enabled",
            1
        )

        welcome_enabled = get_setting(
            chat_id,
            "welcome_enabled",
            1
        )

        # CAPTCHA включена
        if captcha_enabled:

            await bot.restrict_chat_member(
                chat_id=chat_id,
                user_id=user_id,
                permissions=ChatPermissions(
                    can_send_messages=False,
                    can_send_audios=False,
                    can_send_documents=False,
                    can_send_photos=False,
                    can_send_videos=False,
                    can_send_video_notes=False,
                    can_send_voice_notes=False,
                    can_send_polls=False,
                    can_send_other_messages=False,
                    can_add_web_page_previews=False,
                )
            )

            if welcome_enabled:
                await queue_welcome(
                    chat_id,
                    request.from_user
                )

        else:

            # Если CAPTCHA выключена,
            # сразу разрешаем писать.
            await bot.restrict_chat_member(
                chat_id=chat_id,
                user_id=user_id,
                permissions=ChatPermissions(
                    can_send_messages=True,
                    can_send_audios=True,
                    can_send_documents=True,
                    can_send_photos=True,
                    can_send_videos=True,
                    can_send_video_notes=True,
                    can_send_voice_notes=True,
                    can_send_polls=True,
                    can_send_other_messages=True,
                    can_add_web_page_previews=True,
                )
            )

            if welcome_enabled:

                username = (
                    f"@{escape_text(request.from_user.username)}"
                    if request.from_user.username
                    else mention(request.from_user)
                )

                await send_bot_message(
                    chat_id,
                    "👋 <b>Добро пожаловать в Stardew Valley!</b>\n\n"
                    f"🌻 Привет, {username}!\n"
                    "Ознакомься с правилами и присоединяйся к общению."
                )

    except Exception as e:

        logger.exception(
            f"Join request error: {e}"
        )


