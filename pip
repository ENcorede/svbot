        "chat_id": chat_id,
        "creator_id": user.id,
        "creator_name": user.full_name,
        "player2_id": None,
        "player2_name": None,
        "board": [""] * 9,
        "turn": user.id,
        "started": False,
        "created_at": time.time()
    }

    # Удаляем команду пользователя.
    try:
        await message.delete()
