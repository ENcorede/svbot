@dp.message(
    F.chat.type.in_({
        ChatType.GROUP,
        ChatType.SUPERGROUP,
    })
    & ~F.text.startswith("/")
)
async def group_message_filter(
    message: Message,
):
    chat_id = message.chat.id

    if not is_managed_group(chat_id):
        return

    if not message.from_user:
        return

    # Администраторы не попадают под RO/ЧС.
    if await is_group_admin(
        chat_id,
        message.from_user.id,
    ):
        return

    # -------------------------
    # READ ONLY
    # -------------------------

    if get_setting(
        chat_id,
        "readonly",
        0,
    ):

        await safe_delete(message)

        increment_stat(
            chat_id,
            "messages_deleted",
        )

        return

    # -------------------------
    # BLACKLIST
    # -------------------------

    rows = db.execute(
        """
        SELECT word
        FROM blacklist
        WHERE chat_id = ?
        ORDER BY LENGTH(word) DESC
        """,
        (chat_id,),
    ).fetchall()

    if not rows:
        return

    content = (
        message.text
        or message.caption
        or ""
    ).lower()

    for row in rows:

        word = row["word"].lower()

        if word and word in content:

            await safe_delete(message)

            increment_stat(
                chat_id,
                "messages_deleted",
            )

            return


