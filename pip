@dp.message(
    F.chat.type.in_({"group", "supergroup"})
)
async def readonly_and_blacklist(
    message: Message
):

    chat_id = message.chat.id

    if not group_exists(chat_id):
        return

    # Команды обрабатываются другими handlers
    if message.text and message.text.startswith("/"):
        return

    # Администратор не ограничивается
    if await is_group_admin(
        chat_id,
        message.from_user.id
    ):
        return

    # READ ONLY
    if get_setting(
        chat_id,
        "readonly",
        0
    ):

        try:
            await message.delete()
            increment_stat(
                chat_id,
                "messages_deleted"
            )
        except Exception:
            pass

        return

    # BLACKLIST
    rows = db.execute(
        """
        SELECT word
        FROM blacklist
        WHERE chat_id = ?
        ORDER BY LENGTH(word) DESC
        """,
        (chat_id,)
    ).fetchall()

    if not rows:
        return

    text = (
        message.text
        or message.caption
        or ""
    ).lower()

    for row in rows:

        word = row["word"].lower()

        if word in text:

            try:
                await message.delete()

                increment_stat(
                    chat_id,
                    "messages_deleted"
                )

            except Exception:
                pass

            return


